# Caddyfile for Hotlines.world — static site served on Railway.
{
    auto_https off
    admin off
}

:{$PORT} {
    root * /srv
    encode gzip zstd
    file_server

    # Security headers
    header {
        # HSTS (Railway terminates TLS upstream)
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
        # Allow Tailwind and Alpine from CDN, self for everything else
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'self'"
        -Server
    }

    # Cache static assets aggressively, HTML briefly
    @static path *.json *.xml *.txt *.css *.js *.svg *.png *.ico
    header @static Cache-Control "public, max-age=3600, stale-while-revalidate=86400"

    @html path *.html /
    header @html Cache-Control "public, max-age=300, stale-while-revalidate=86400"

    # Friendly routing: /country/us → /country/us.html
    try_files {path} {path}.html {path}/index.html /404.html

    # 404
    handle_errors {
        @404 expression {err.status_code} == 404
        rewrite @404 /404.html
        file_server
    }

    log {
        output stdout
        format console
    }
}
