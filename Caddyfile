# Caddyfile for Hotlines.world — Astro static site served on Railway.
{
    auto_https off
    admin off
}

:{$PORT} {
    @www host www.worldhotlines.org
    redir @www https://worldhotlines.org{uri} permanent

    root * /srv
    encode gzip zstd
    file_server

    # Security headers
    header {
        # HSTS (Railway terminates TLS upstream)
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
        # CSP:
        #  - 'self' for all script/style (Astro ships local bundles)
        #  - Leaflet JS/CSS (from unpkg) + OSM/CARTO tiles for the world map
        #  - data: for inline SVG icons
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.basemaps.cartocdn.com https://*.tile.openstreetmap.org https://*.openstreetmap.org; connect-src 'self' https://*.basemaps.cartocdn.com https://*.tile.openstreetmap.org https://*.openstreetmap.org; worker-src 'self' blob:; child-src 'self' blob:; base-uri 'self'; form-action 'self'"
        -Server
    }

    # Astro hashed assets — immutable cache
    @assets path /_astro/*
    header @assets Cache-Control "public, max-age=31536000, immutable"

    # Data shards — moderate cache, SWR so a redeploy refreshes quickly
    @data path /data/*
    header @data Cache-Control "public, max-age=300, stale-while-revalidate=86400"

    # Static API — isolate it from the friendly HTML fallback so unknown
    # artifacts keep a real 404 status.
    handle /api/v1/* {
        route {
            header {
                Access-Control-Allow-Origin "*"
                Access-Control-Allow-Methods "GET, HEAD"
                Access-Control-Allow-Headers "Accept, If-None-Match, If-Modified-Since"
                Cache-Control "public, max-age=300, stale-while-revalidate=86400"
            }
            @apiResolver path /api/v1/resolver.js
            header @apiResolver Content-Type "text/javascript; charset=utf-8"
            file_server {
                pass_thru
            }
            respond "Not found" 404
        }
    }

    # Release descriptors are cross-origin verifiable metadata. Keep unknown
    # descriptor paths as real 404s; the Railway hostname has no special case.
    route {
        handle /feeds/* {
            route {
                @feedJson path *.json
                header @feedJson Content-Type "application/feed+json; charset=utf-8"
                @feedRss path *.rss
                header @feedRss Content-Type "application/rss+xml; charset=utf-8"
                @feedAtom path *.atom
                header @feedAtom Content-Type "application/atom+xml; charset=utf-8"
                header {
                    Access-Control-Allow-Origin "*"
                    Cache-Control "public, max-age=300, stale-while-revalidate=86400"
                }
                file_server {
                    pass_thru
                }
                respond "Not found" 404
            }
        }

        handle /release/v1/* {
            route {
                @releaseOptions method OPTIONS
                header @releaseOptions {
                    Access-Control-Allow-Origin "*"
                    Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
                    Access-Control-Allow-Headers "Accept, If-None-Match, If-Modified-Since"
                }
                respond @releaseOptions 204

                @releaseFile file {path}
                header @releaseFile {
                    Access-Control-Allow-Origin "*"
                    Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
                    Access-Control-Allow-Headers "Accept, If-None-Match, If-Modified-Since"
                    Cache-Control "public, max-age=60, stale-while-revalidate=300"
                    Content-Type "application/json; charset=utf-8"
                }
                file_server @releaseFile

                header {
                    Access-Control-Allow-Origin "*"
                    Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
                    Access-Control-Allow-Headers "Accept, If-None-Match, If-Modified-Since"
                    Cache-Control "no-store"
                    Content-Type "text/plain; charset=utf-8"
                }
                respond "Not found" 404
            }
        }

        # Friendly routing: /country/au → /country/au/index.html (Astro default layout)
        try_files {path} {path}.html {path}/index.html =404
    }

    # Static media
    @media path *.css *.js *.svg *.png *.ico *.webp *.woff2
    header @media Cache-Control "public, max-age=3600, stale-while-revalidate=86400"

    # HTML pages — short cache
    @html path *.html /
    header @html Cache-Control "public, max-age=120, stale-while-revalidate=86400"

    handle_errors {
        @404 expression {err.status_code} == 404
        rewrite @404 /404.html
        file_server
    }

    log {
        output stdout
        format console
    }
}
