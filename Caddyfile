                @organizationOpenApi path */openapi.json
                header @organizationOpenApi Content-Type "application/vnd.oai.openapi+json; charset=utf-8"
                @organizationMarkdown path *.md
                header @organizationMarkdown Content-Type "text/markdown; charset=utf-8"
                @organizationFile file {path}
                header @organizationFile {
                    Access-Control-Allow-Origin "*"
                    Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
                    Access-Control-Allow-Headers "Accept, If-None-Match, If-Modified-Since"
                    Cache-Control "public, max-age=300, stale-while-revalidate=86400"
                }
                file_server @organizationFile
                respond "Not found" 404
            }
        }

