# Caddyfile for Hotlines.world — Astro static site served on Railway.
{
    auto_https off
    admin off
}

:{$PORT} {
    @www host www.worldhotlines.org
    redir @www https://worldhotlines.org{uri} permanent

    root * /srv
    encode gzip zstd
    file_server

    # Security headers
    header {
        # HSTS (Railway terminates TLS upstream)
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
        # CSP:
        #  - 'self' for all script/style (Astro ships local bundles)
        #  - Leaflet JS/CSS (from unpkg) + OSM/CARTO tiles for the world map
        #  - data: for inline SVG icons
        #  - form-action also allows the Stripe hosted Checkout and Customer
        #    Portal origins so a same-origin POST to /billing/api/* may 303 there.
        #    No Stripe script, frame, or connect-src is allowed: card entry
        #    happens on Stripe's origin, never on this one.
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.basemaps.cartocdn.com https://*.tile.openstreetmap.org https://*.openstreetmap.org; connect-src 'self' https://*.basemaps.cartocdn.com https://*.tile.openstreetmap.org https://*.openstreetmap.org; worker-src 'self' blob:; child-src 'self' blob:; base-uri 'self'; form-action 'self' https://checkout.stripe.com https://billing.stripe.com"
        -Server
    }

    # Astro hashed assets — immutable cache
    @assets path /_astro/*
    header @assets Cache-Control "public, max-age=31536000, immutable"

    # Service-worker updates must reach the network; its finite shell owns its
    # own strictly versioned cache. The manifest may be revalidated normally.
    @serviceWorker path /service-worker.js
    header @serviceWorker Cache-Control "no-cache"
    @webManifest path /manifest.webmanifest
    header @webManifest Content-Type "application/manifest+json; charset=utf-8"

    # Data shards — moderate cache, SWR so a redeploy refreshes quickly
    @data path /data/*
    header @data Cache-Control "public, max-age=300, stale-while-revalidate=86400"

    # Static API — isolate it from the friendly HTML fallback so unknown
    # artifacts keep a real 404 status.
    handle /api/v1/* {
        route {
            header {
                Access-Control-Allow-Origin "*"
                Access-Control-Allow-Methods "GET, HEAD"
                Access-Control-Allow-Headers "Accept, If-None-Match, If-Modified-Since"
                Cache-Control "public, max-age=300, stale-while-revalidate=86400"
            }
            @apiWrite not method GET HEAD
            respond @apiWrite "Not found" 404
            @apiResolver path /api/v1/resolver.js
            header @apiResolver Content-Type "text/javascript; charset=utf-8"
            @travelerCardsGzip path /api/v1/traveler-cards.json.gz
            header @travelerCardsGzip {
                Content-Type "application/gzip"
                -Content-Encoding
            }
            file_server {
                pass_thru
            }
            respond "Not found" 404
        }
    }

    # Payments foundation (Stripe hosted Checkout) — PREPARED, NOT ENABLED.
    # Fails closed: while PAYMENTS_UPSTREAM is unset every /billing/api/* request
    # answers 503 and no checkout can start. Set PAYMENTS_UPSTREAM to the
    # payments service address (for example payments.railway.internal:8081)
    # only after completing docs/PAYMENTS.md. Never cached, never served from
    # disk, and free static crisis-information surfaces are unaffected.
    handle /billing/api/* {
        route {
            @paymentsEnabled expression `{env.PAYMENTS_UPSTREAM} != ""`
            reverse_proxy @paymentsEnabled {env.PAYMENTS_UPSTREAM} {
                # The site-level header block already sets these; drop the
                # upstream copies so each security header appears exactly once.
                header_down -Content-Security-Policy
                header_down -X-Content-Type-Options
                header_down -Referrer-Policy
            }
            header {
                Cache-Control "no-store"
                Content-Type "application/json; charset=utf-8"
            }
            respond `{"error":{"code":"payments_disabled","message":"Payments are not enabled"}}` 503
        }
    }

    # Release descriptors are cross-origin verifiable metadata. Keep unknown
    # descriptor paths as real 404s; the Railway hostname has no special case.
    route {
        # Static managed-gateway design artifacts only. This is not the dynamic
        # gateway service and accepts no writes.
        handle /gateway/v1/* {
            route {
                @gatewayOptions method OPTIONS
                header @gatewayOptions {
                    Access-Control-Allow-Origin "*"
                    Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
                    Access-Control-Allow-Headers "Accept, If-None-Match, If-Modified-Since"
                }
                respond @gatewayOptions 204
                @gatewayWrite not method GET HEAD OPTIONS
                respond @gatewayWrite "Not found" 404
                @gatewaySchema path *.schema.json
                header @gatewaySchema Content-Type "application/schema+json; charset=utf-8"
                @gatewayOpenApi path */openapi.json
                header @gatewayOpenApi Content-Type "application/vnd.oai.openapi+json; charset=utf-8"
                @gatewayMarkdown path *.md
                header @gatewayMarkdown Content-Type "text/markdown; charset=utf-8"
                @gatewayFile file {path}
                header @gatewayFile {
                    Access-Control-Allow-Origin "*"
                    Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
                    Access-Control-Allow-Headers "Accept, If-None-Match, If-Modified-Since"
                    Cache-Control "public, max-age=300, stale-while-revalidate=86400"
                }
                file_server @gatewayFile
                respond "Not found" 404
            }
        }

        handle /subscriptions/v1/* {
            route {
                @subscriptionOptions method OPTIONS
                header @subscriptionOptions {
                    Access-Control-Allow-Origin "*"
                    Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
                    Access-Control-Allow-Headers "Accept, If-None-Match, If-Modified-Since"
                }
                respond @subscriptionOptions 204

                @subscriptionWrite not method GET HEAD OPTIONS
                header @subscriptionWrite {
                    Access-Control-Allow-Origin "*"
                    Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
                    Cache-Control "no-store"
                    Content-Type "text/plain; charset=utf-8"
                }
                respond @subscriptionWrite "Not found" 404

                @subscriptionSchema path *.schema.json
                header @subscriptionSchema Content-Type "application/schema+json; charset=utf-8"
                @subscriptionOpenApi path */openapi.json
                header @subscriptionOpenApi Content-Type "application/vnd.oai.openapi+json; charset=utf-8"
                @subscriptionMarkdown path *.md
                header @subscriptionMarkdown Content-Type "text/markdown; charset=utf-8"
                @subscriptionFile file {path}
                header @subscriptionFile {
                    Access-Control-Allow-Origin "*"
                    Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
                    Access-Control-Allow-Headers "Accept, If-None-Match, If-Modified-Since"
                    Cache-Control "public, max-age=300, stale-while-revalidate=86400"
                }
                file_server @subscriptionFile
                header {
                    Access-Control-Allow-Origin "*"
                    Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
                    Cache-Control "no-store"
                    Content-Type "text/plain; charset=utf-8"
                }
                respond "Not found" 404
            }
        }

