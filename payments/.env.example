# Payments foundation — example environment. Copy to `.env` locally (gitignored)
# or set these as Railway service variables. Never commit real values.
#
# Kill switch. `disabled` (default) serves health only and answers every
# payment route with 503. `test` requires sk_test_/rk_test_ keys; `live`
# requires sk_live_/rk_live_ keys and an https public origin.
PAYMENTS_MODE=disabled

# Bind address and port. Railway private networking is IPv6: use `::` there.
PAYMENTS_HOST=127.0.0.1
PORT=8081

# Canonical site origin. Used for Checkout return URLs and the same-origin
# check on browser-initiated requests. Loopback http is allowed only in test mode.
PAYMENTS_PUBLIC_ORIGIN=https://worldhotlines.org
PAYMENTS_SUCCESS_PATH=/billing/success
PAYMENTS_CANCEL_PATH=/billing/cancelled
# PAYMENTS_RETURN_PATH=/account
# PAYMENTS_RETURN_PATH is deprecated and ignored; remove it from older deployments.
# It cannot change routing or authorize portal access with a session ID.

# Set to 1 when the service sits behind Caddy/Railway so X-Forwarded-For is
# used for abuse limiting. Advisory only; not an authentication boundary.
PAYMENTS_TRUST_PROXY=1

# Stripe credentials. Create a restricted key (rk_) with Checkout Sessions
# write and read, Subscriptions read, and Invoices read; it is enough — this
# service reconciles webhook events by reading subscriptions and invoices but
# never calls the Customer/Billing Portal API. Do not grant Billing Portal;
# the CMS's separate restricted key holds that permission (docs/ACCOUNTS.md).
STRIPE_SECRET_KEY=rk_test_replace_with_a_restricted_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_the_endpoint_signing_secret
# Optional: pin the Stripe API version shown in the Dashboard, e.g. 2025-08-27.basil
# STRIPE_API_VERSION=

# Offer map: offer id -> Stripe price. Offer ids must match
# payments/contracts/v1/offers.json; the browser only ever sends an offer id,
# never a price id. `quantity` is optional and defaults to 1.
PAYMENTS_OFFERS={"growth_monthly":{"price":"price_replace_with_dashboard_price_id","mode":"subscription"}}

# Store for webhook idempotency and entitlement state. `memory` (default) is
# single-instance and forgets on restart. `cms` persists both in the Payload
# CMS (`cms/`, collections stripe-events and entitlements) through a service
# API key, and is required before more than one replica runs. The URL is the
# CMS API base (Railway private networking: http://cms.railway.internal:3000/cms/api).
PAYMENTS_STORE=memory
# PAYMENTS_CMS_URL=http://cms.railway.internal:3000/cms/api
# PAYMENTS_CMS_API_KEY=replace_with_the_service_users_api_key

# Optional: enable Stripe Tax on Checkout Sessions (requires Tax configured in
# the Dashboard and a tax/legal decision). Off by default.
PAYMENTS_AUTOMATIC_TAX=0
# Optional: outbound Stripe API timeout in milliseconds (1000–120000).
PAYMENTS_STRIPE_TIMEOUT_MS=15000
