{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://worldhotlines.org/organizations/v1/model.schema.json",
  "title":"Organization control-plane v1 foundation design contract — static synthetic fixture; not deployed",
  "type":"object","additionalProperties":false,
  "required":["contract_status","effective_at","organizations","projects","role_assignments","key_references","hosted_config_versions","transition_scenarios"],
  "properties":{
    "contract_status":{"const":"foundation-design-contract-not-deployed"},"effective_at":{"$ref":"#/$defs/utc"},
    "organizations":{"type":"array","maxItems":16,"items":{"$ref":"#/$defs/organization"}},"projects":{"type":"array","maxItems":32,"items":{"$ref":"#/$defs/project"}},
    "role_assignments":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/assignment"}},"key_references":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/key"}},
    "hosted_config_versions":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/config"}},"transition_scenarios":{"type":"array","maxItems":16,"items":{"$ref":"#/$defs/scenario"}}
  },
  "$defs":{
    "utc":{"type":"string","format":"date-time","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "orgId":{"type":"string","pattern":"^org_demo_[a-z0-9]{4,24}$"},"projectId":{"type":"string","pattern":"^project_demo_[a-z0-9]{4,24}$"},"principalId":{"type":"string","pattern":"^principal_demo_[a-z0-9]{4,24}$"},"assignmentId":{"type":"string","pattern":"^assignment_demo_[a-z0-9]{4,24}$"},"keyId":{"type":"string","pattern":"^keyref_demo_[a-z0-9]{4,24}$"},"configId":{"type":"string","pattern":"^config_demo_[a-z0-9]{4,24}$"},"commandId":{"type":"string","pattern":"^command_demo_[a-z0-9]{4,24}$"},"requestId":{"type":"string","pattern":"^request_demo_[a-z0-9]{4,24}$"},
    "label":{"type":"string","pattern":"^Synthetic [A-Za-z0-9 -]{1,48} [(]non-customer[)]$","maxLength":80},
    "origin":{"type":"string","format":"uri","pattern":"^https://[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*\\.example\\.invalid$","maxLength":160,"description":"Canonical lowercase HTTPS synthetic DNS origin only; semantic validation additionally rejects reserved/ambiguous labels, IP-like hosts, ports, credentials, paths, queries, fragments, percent encoding, and punycode."},
    "permission":{"enum":["organization.read","project.read","project.configure","roles.read","roles.manage","keys.read","keys.manage","configs.read","configs.manage","audit.read"]},"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "organization":{"type":"object","additionalProperties":false,"required":["id","display_label","state","policy_version","contract_version","project_ids","role_assignment_ids","created_at","updated_at"],"properties":{"id":{"$ref":"#/$defs/orgId"},"display_label":{"$ref":"#/$defs/label"},"state":{"enum":["active","suspended","archived"]},"policy_version":{"type":"integer","minimum":1,"maximum":9999},"contract_version":{"const":"organizations/v1"},"project_ids":{"type":"array","maxItems":32,"uniqueItems":true,"items":{"$ref":"#/$defs/projectId"}},"role_assignment_ids":{"type":"array","maxItems":64,"uniqueItems":true,"items":{"$ref":"#/$defs/assignmentId"}},"created_at":{"$ref":"#/$defs/utc"},"updated_at":{"$ref":"#/$defs/utc"}}},
    "project":{"type":"object","additionalProperties":false,"required":["id","organization_id","display_label","state","allowed_origins","api_major_allowlist","key_reference_ids","hosted_config_version_ids","active_hosted_config_version_id","created_at","updated_at"],"properties":{"id":{"$ref":"#/$defs/projectId"},"organization_id":{"$ref":"#/$defs/orgId"},"display_label":{"$ref":"#/$defs/label"},"state":{"enum":["active","suspended","archived"]},"allowed_origins":{"type":"array","maxItems":16,"uniqueItems":true,"items":{"$ref":"#/$defs/origin"}},"api_major_allowlist":{"type":"array","minItems":1,"maxItems":4,"uniqueItems":true,"items":{"type":"integer","minimum":1,"maximum":9}},"key_reference_ids":{"type":"array","maxItems":32,"uniqueItems":true,"items":{"$ref":"#/$defs/keyId"}},"hosted_config_version_ids":{"type":"array","maxItems":64,"uniqueItems":true,"items":{"$ref":"#/$defs/configId"}},"active_hosted_config_version_id":{"anyOf":[{"$ref":"#/$defs/configId"},{"type":"null"}]},"created_at":{"$ref":"#/$defs/utc"},"updated_at":{"$ref":"#/$defs/utc"}}},
    "assignment":{"type":"object","additionalProperties":false,"required":["id","principal_id","organization_id","project_id","role","permissions","state","effective_at","revoked_at","created_at","updated_at"],"properties":{"id":{"$ref":"#/$defs/assignmentId"},"principal_id":{"$ref":"#/$defs/principalId"},"organization_id":{"$ref":"#/$defs/orgId"},"project_id":{"anyOf":[{"$ref":"#/$defs/projectId"},{"type":"null"}]},"role":{"enum":["owner","admin","developer","viewer"]},"permissions":{"type":"array","minItems":1,"maxItems":10,"uniqueItems":true,"items":{"$ref":"#/$defs/permission"}},"state":{"enum":["active","suspended","revoked"]},"effective_at":{"$ref":"#/$defs/utc"},"revoked_at":{"anyOf":[{"$ref":"#/$defs/utc"},{"type":"null"}]},"created_at":{"$ref":"#/$defs/utc"},"updated_at":{"$ref":"#/$defs/utc"}}},
    "key":{"type":"object","additionalProperties":false,"required":["id","organization_id","project_id","api_major","permissions","quota_summary","state","not_before","expires_at","rotation_predecessor_id","created_at","updated_at"],"properties":{"id":{"$ref":"#/$defs/keyId"},"organization_id":{"$ref":"#/$defs/orgId"},"project_id":{"$ref":"#/$defs/projectId"},"api_major":{"type":"integer","minimum":1,"maximum":9},"permissions":{"type":"array","minItems":1,"maxItems":2,"uniqueItems":true,"items":{"enum":["api.read","widget.resolve"]}},"quota_summary":{"type":"object","additionalProperties":false,"required":["window","request_limit"],"properties":{"window":{"enum":["minute","hour","day"]},"request_limit":{"type":"integer","minimum":1,"maximum":1000000}}},"state":{"enum":["pending","active","suspended","expired","revoked"]},"not_before":{"$ref":"#/$defs/utc"},"expires_at":{"anyOf":[{"$ref":"#/$defs/utc"},{"type":"null"}]},"rotation_predecessor_id":{"anyOf":[{"$ref":"#/$defs/keyId"},{"type":"null"}]},"created_at":{"$ref":"#/$defs/utc"},"updated_at":{"$ref":"#/$defs/utc"}}},
    "configContent":{"type":"object","additionalProperties":false,"required":["id","organization_id","project_id","revision","allowed_origins","widget_major","presentation","resolver_defaults","previous_version_id","created_at"],"properties":{"id":{"$ref":"#/$defs/configId"},"organization_id":{"$ref":"#/$defs/orgId"},"project_id":{"$ref":"#/$defs/projectId"},"revision":{"type":"integer","minimum":1,"maximum":1000000},"allowed_origins":{"type":"array","minItems":1,"maxItems":16,"uniqueItems":true,"items":{"$ref":"#/$defs/origin"}},"widget_major":{"type":"integer","minimum":1,"maximum":9},"presentation":{"type":"object","additionalProperties":false,"required":["theme","density","show_attribution","max_results"],"properties":{"theme":{"enum":["light","dark","system"]},"density":{"enum":["compact","comfortable"]},"show_attribution":{"type":"boolean"},"max_results":{"type":"integer","minimum":1,"maximum":20}}},"resolver_defaults":{"type":"object","additionalProperties":false,"required":["language_mode","sort_mode","empty_state"],"properties":{"language_mode":{"enum":["document","browser"]},"sort_mode":{"enum":["source_order","alphabetical"]},"empty_state":{"enum":["hidden","generic_message"]}}},"previous_version_id":{"anyOf":[{"$ref":"#/$defs/configId"},{"type":"null"}]},"created_at":{"$ref":"#/$defs/utc"}}},
    "config":{"type":"object","additionalProperties":false,"required":["content","content_digest","lifecycle","signature_metadata"],"properties":{"content":{"$ref":"#/$defs/configContent"},"content_digest":{"$ref":"#/$defs/digest","description":"Unsigned design metadata: SHA-256 of canonical immutable content only; lifecycle is mutable and excluded."},"lifecycle":{"type":"object","additionalProperties":false,"required":["state","updated_at"],"properties":{"state":{"enum":["draft","active","retired"]},"updated_at":{"$ref":"#/$defs/utc"}}},"signature_metadata":{"type":"object","additionalProperties":false,"required":["status","algorithm","key_reference"],"properties":{"status":{"const":"design-only-not-signed"},"algorithm":{"const":"none"},"key_reference":{"type":"null"}}}}},
    "command":{"type":"object","additionalProperties":false,"required":["id","request_id","action","organization_id","project_id","actor_principal_id","target_config_version_id","expected_active_config_version_id","timestamp"],"properties":{"id":{"$ref":"#/$defs/commandId"},"request_id":{"$ref":"#/$defs/requestId"},"action":{"const":"activate_hosted_config_version"},"organization_id":{"$ref":"#/$defs/orgId"},"project_id":{"$ref":"#/$defs/projectId"},"actor_principal_id":{"$ref":"#/$defs/principalId"},"target_config_version_id":{"$ref":"#/$defs/configId"},"expected_active_config_version_id":{"$ref":"#/$defs/configId"},"timestamp":{"$ref":"#/$defs/utc"}}},
    "acceptedResult":{"type":"object","additionalProperties":false,"required":["command_id","request_id","outcome","reason_code","changed","previous_active_config_version_id","active_config_version_id","timestamp"],"properties":{"command_id":{"$ref":"#/$defs/commandId"},"request_id":{"$ref":"#/$defs/requestId"},"outcome":{"const":"accepted"},"reason_code":{"const":"activated_prior_content_version"},"changed":{"const":true},"previous_active_config_version_id":{"$ref":"#/$defs/configId"},"active_config_version_id":{"$ref":"#/$defs/configId"},"timestamp":{"$ref":"#/$defs/utc"}}},
    "rejectedResult":{"type":"object","additionalProperties":false,"required":["command_id","request_id","outcome","reason_code","changed","active_config_version_id","timestamp"],"properties":{"command_id":{"$ref":"#/$defs/commandId"},"request_id":{"$ref":"#/$defs/requestId"},"outcome":{"const":"rejected"},"reason_code":{"enum":["authorization_denied","binding_mismatch","concurrent_state_mismatch","invalid_lifecycle"]},"changed":{"const":false},"active_config_version_id":{"anyOf":[{"$ref":"#/$defs/configId"},{"type":"null"}]},"timestamp":{"$ref":"#/$defs/utc"}}},"result":{"oneOf":[{"$ref":"#/$defs/acceptedResult"},{"$ref":"#/$defs/rejectedResult"}]},
    "configAuditAccepted":{"type":"object","additionalProperties":false,"required":["id","command_id","action","outcome","reason_code","actor_principal_id","organization_id","project_id","config_version_id","key_reference_id","assignment_id","request_id","timestamp"],"properties":{"id":{"type":"string","pattern":"^audit_demo_[a-z0-9]{4,24}$"},"command_id":{"$ref":"#/$defs/commandId"},"action":{"const":"hosted_config.activated"},"outcome":{"const":"accepted"},"reason_code":{"const":"policy_allowed"},"actor_principal_id":{"$ref":"#/$defs/principalId"},"organization_id":{"$ref":"#/$defs/orgId"},"project_id":{"$ref":"#/$defs/projectId"},"config_version_id":{"$ref":"#/$defs/configId"},"key_reference_id":{"type":"null"},"assignment_id":{"type":"null"},"request_id":{"$ref":"#/$defs/requestId"},"timestamp":{"$ref":"#/$defs/utc"}}},
    "configAuditRejected":{"type":"object","additionalProperties":false,"required":["id","command_id","action","outcome","reason_code","actor_principal_id","organization_id","project_id","config_version_id","key_reference_id","assignment_id","request_id","timestamp"],"properties":{"id":{"type":"string","pattern":"^audit_demo_[a-z0-9]{4,24}$"},"command_id":{"$ref":"#/$defs/commandId"},"action":{"const":"hosted_config.activated"},"outcome":{"const":"rejected"},"reason_code":{"enum":["authorization_denied","binding_mismatch","concurrent_state_mismatch","invalid_lifecycle"]},"actor_principal_id":{"$ref":"#/$defs/principalId"},"organization_id":{"$ref":"#/$defs/orgId"},"project_id":{"$ref":"#/$defs/projectId"},"config_version_id":{"$ref":"#/$defs/configId"},"key_reference_id":{"type":"null"},"assignment_id":{"type":"null"},"request_id":{"$ref":"#/$defs/requestId"},"timestamp":{"$ref":"#/$defs/utc"}}},
    "audit":{"oneOf":[{"$ref":"#/$defs/configAuditAccepted"},{"$ref":"#/$defs/configAuditRejected"}]},
    "before":{"type":"object","additionalProperties":false,"required":["project_id","active_config_version_id","active_config_state","target_config_version_id","target_config_state"],"properties":{"project_id":{"$ref":"#/$defs/projectId"},"active_config_version_id":{"$ref":"#/$defs/configId"},"active_config_state":{"const":"active"},"target_config_version_id":{"$ref":"#/$defs/configId"},"target_config_state":{"enum":["draft","retired"]}}},
    "acceptedAfter":{"type":"object","additionalProperties":false,"required":["project_id","active_config_version_id","active_config_state","prior_config_version_id","prior_config_state","updated_at"],"properties":{"project_id":{"$ref":"#/$defs/projectId"},"active_config_version_id":{"$ref":"#/$defs/configId"},"active_config_state":{"const":"active"},"prior_config_version_id":{"$ref":"#/$defs/configId"},"prior_config_state":{"const":"retired"},"updated_at":{"$ref":"#/$defs/utc"}}},
    "rejectedAfter":{"type":"object","additionalProperties":false,"required":["unchanged","project_id","active_config_version_id","active_config_state","target_config_version_id","target_config_state"],"properties":{"unchanged":{"const":true},"project_id":{"$ref":"#/$defs/projectId"},"active_config_version_id":{"$ref":"#/$defs/configId"},"active_config_state":{"const":"active"},"target_config_version_id":{"$ref":"#/$defs/configId"},"target_config_state":{"enum":["draft","retired"]}}},
    "acceptedScenario":{"type":"object","additionalProperties":false,"required":["id","before","command","result","audit_event","expected_after"],"properties":{"id":{"type":"string","pattern":"^scenario_demo_[a-z0-9]{4,24}$"},"before":{"$ref":"#/$defs/before"},"command":{"$ref":"#/$defs/command"},"result":{"$ref":"#/$defs/acceptedResult"},"audit_event":{"$ref":"#/$defs/configAuditAccepted"},"expected_after":{"$ref":"#/$defs/acceptedAfter"}}},
    "rejectedScenario":{"type":"object","additionalProperties":false,"required":["id","before","command","result","audit_event","expected_after"],"properties":{"id":{"type":"string","pattern":"^scenario_demo_[a-z0-9]{4,24}$"},"before":{"$ref":"#/$defs/before"},"command":{"$ref":"#/$defs/command"},"result":{"$ref":"#/$defs/rejectedResult"},"audit_event":{"$ref":"#/$defs/configAuditRejected"},"expected_after":{"$ref":"#/$defs/rejectedAfter"}}},
    "scenario":{"oneOf":[{"$ref":"#/$defs/acceptedScenario"},{"$ref":"#/$defs/rejectedScenario"}]}
  }
}
