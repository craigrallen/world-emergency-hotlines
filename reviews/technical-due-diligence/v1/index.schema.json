{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "internal-technical-due-diligence-evidence-index/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "internal_only_marker", "purpose", "limitations", "status_vocabulary", "sources", "domains"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "internal_only_marker": { "const": "internal-technical-due-diligence-evidence-only/v1" },
    "purpose": { "const": "repository_internal_deterministic_regression_evidence_index" },
    "limitations": { "type": "array", "minItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 10 } },
    "status_vocabulary": { "const": ["verified_static", "manual", "not_assessed", "held"] },
    "sources": { "type": "object", "minProperties": 1, "propertyNames": { "pattern": "^(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$" }, "additionalProperties": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } },
    "domains": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "prefixItems": [
        { "$ref": "#/$defs/release_integrity" },
        { "$ref": "#/$defs/deployment_build" },
        { "$ref": "#/$defs/accessibility" },
        { "$ref": "#/$defs/multilingual_qualification_review" },
        { "$ref": "#/$defs/security_privacy" },
        { "$ref": "#/$defs/internal_control_integrity" }
      ],
      "items": false
    }
  },
  "$defs": {
    "artifact": { "type": "object", "additionalProperties": false, "required": ["path", "proves_narrowly", "does_not_prove", "review_status", "next_qualified_or_manual_gate"], "properties": { "path": { "type": "string", "pattern": "^(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$" }, "proves_narrowly": { "type": "string", "minLength": 20 }, "does_not_prove": { "type": "string", "minLength": 20 }, "review_status": { "enum": ["verified_static", "manual", "not_assessed", "held"] }, "next_qualified_or_manual_gate": { "type": "string", "minLength": 20 } } },
    "release_integrity": { "$ref": "#/$defs/domain_release_integrity" },
    "deployment_build": { "$ref": "#/$defs/domain_deployment_build" },
    "accessibility": { "$ref": "#/$defs/domain_accessibility" },
    "multilingual_qualification_review": { "$ref": "#/$defs/domain_multilingual_qualification_review" },
    "security_privacy": { "$ref": "#/$defs/domain_security_privacy" },
    "internal_control_integrity": { "$ref": "#/$defs/domain_internal_control_integrity" },
    "domain_release_integrity": { "type": "object", "additionalProperties": false, "required": ["id", "artifacts"], "properties": { "id": { "const": "release_integrity" }, "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } } } },
    "domain_deployment_build": { "type": "object", "additionalProperties": false, "required": ["id", "artifacts"], "properties": { "id": { "const": "deployment_build" }, "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } } } },
    "domain_accessibility": { "type": "object", "additionalProperties": false, "required": ["id", "artifacts"], "properties": { "id": { "const": "accessibility" }, "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } } } },
    "domain_multilingual_qualification_review": { "type": "object", "additionalProperties": false, "required": ["id", "artifacts"], "properties": { "id": { "const": "multilingual_qualification_review" }, "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } } } },
    "domain_security_privacy": { "type": "object", "additionalProperties": false, "required": ["id", "artifacts"], "properties": { "id": { "const": "security_privacy" }, "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } } } },
    "domain_internal_control_integrity": { "type": "object", "additionalProperties": false, "required": ["id", "artifacts"], "properties": { "id": { "const": "internal_control_integrity" }, "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } } } }
  }
}
