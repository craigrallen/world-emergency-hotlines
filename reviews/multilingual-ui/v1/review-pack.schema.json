          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "valueState": {
          "enum": [
            "source_master",
            "locale_override",
            "english_fallback"
          ]
        },
        "manifestReviewStatus": {
          "enum": [
            "source_master_not_formally_certified",
            "not_independently_human_reviewed"
          ]
        },
        "reviewerDecision": {
