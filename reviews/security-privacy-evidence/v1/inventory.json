      "assertions": [
        { "id": "synthetic_credentials_only", "status": "verified_static", "statement": "The managed gateway fixture and tests use synthetic key records and explicitly exercise separation from the production-mode contract; this is not evidence about live credentials or routes.", "evidence": ["gateway/fixtures/keys.synthetic.json", "gateway/src/security.mjs", "gateway/test/gateway.test.mjs"], "checks": ["web_verify_gateway"] }
      ]
    },
    {
      "id": "ci_build_image_nonpublication",
      "assertions": [
        { "id": "required_web_ci_wiring", "status": "verified_static", "statement": "The bound Web CI workflow invokes verify:all, whose package script includes the internal inventory verification path.", "evidence": [".github/workflows/web-ci.yml", "web/package.json", "web/scripts/security-privacy-evidence-lib.mjs", "web/scripts/security-privacy-evidence.test.mjs", "web/scripts/verify-security-privacy-evidence.mjs"], "checks": ["web_verify_security_privacy_evidence"] },
        { "id": "internal_artifact_exclusion", "status": "verified_static", "statement": "The complete reviews tree is excluded from Docker build context; web/dist is scanned for listed stable markers, exact complete artifact hashes, recursive internal semantic subtrees, unique substantive internal scalar fingerprints, and normalized purpose-specific field-clearance tuples through bounded fixed-point character-reference/percent/JavaScript decoding, parser-aware HTML/XML-family representations, and context-specific CSS escape decoding, while the final served root /srv is scanned for listed paths and markers and representative routes. Arbitrary encryption, compression, paraphrase, and OS files outside /srv are not claimed as covered.", "evidence": [".dockerignore", "Dockerfile", "web/scripts/verify-internal-nonpublication.mjs", "web/scripts/verify-docker-image.sh"], "checks": ["web_verify_internal_nonpublication", "web_verify_security_privacy_evidence", "web_verify_docker_image"] }
      ]
    },
