        { "id": "operational_and_provider_practices", "status": "held", "statement": "Operational response, retention outside these static contracts, subprocessors, and third-party provider practices are held outside this bounded repository artifact.", "evidence": ["gateway/contracts/v1/privacy.json", "reviews/multilingual-ui/v1/README.md"], "checks": [] },
