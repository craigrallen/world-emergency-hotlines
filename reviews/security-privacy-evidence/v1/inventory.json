      "assertions": [
        { "id": "release_file_identity_checks", "status": "verified_static", "statement": "Release verification checks finite generated artifact identities and rejects covered symlinks for the cited implementation; this is not a general filesystem or cryptographic assurance.", "evidence": ["web/scripts/release-integrity.mjs", "web/scripts/verify-release-integrity.mjs", "web/scripts/verify-release-reproducibility.mjs"], "checks": ["web_verify_release"] },
        { "id": "gateway_artifact_pinning", "status": "verified_static", "statement": "The synthetic gateway artifact reader implements the bound descriptor, regular-file, size, digest, and no-follow checks exercised by its tests.", "evidence": ["gateway/src/artifacts.mjs", "gateway/test/gateway.test.mjs"], "checks": ["web_verify_gateway"] }
      ]
    },
