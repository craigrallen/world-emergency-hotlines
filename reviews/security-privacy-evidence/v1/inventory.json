      "assertions": [
        { "id": "canonical_build_read_boundary", "status": "verified_static", "statement": "The cited web build and verifier treat hotlines.json as a fixed input and bind its current raw bytes in this inventory; they do not establish all repository mutation governance.", "evidence": ["hotlines.json", "web/scripts/build-static-data.mjs", "web/scripts/verify-static-data.mjs"], "checks": ["web_verify_data", "web_verify_security_privacy_evidence"] }
      ]
