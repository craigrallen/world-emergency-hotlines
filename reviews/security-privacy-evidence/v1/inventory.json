      "id": "data_flow_privacy_boundaries",
      "assertions": [
        { "id": "static_dataset_consumer", "status": "verified_static", "statement": "The cited build reads canonical repository data to generate static public artifacts; this inventory does not assert behavior outside that build path.", "evidence": ["hotlines.json", "web/scripts/build-static-data.mjs", "web/scripts/verify-static-data.mjs"], "checks": ["web_verify_data"] },
        { "id": "declared_gateway_privacy_contract", "status": "verified_static", "statement": "The synthetic managed gateway contract declares its bounded privacy fields and is tested as a repository contract, not as a deployed-service observation.", "evidence": ["gateway/contracts/v1/privacy.json", "gateway/test/gateway.test.mjs"], "checks": ["web_verify_gateway"] }
      ]
    },
    {
      "id": "static_delivery_read_only_routes",
      "assertions": [
        { "id": "static_image_delivery", "status": "verified_static", "statement": "The production Dockerfile copies the Astro build output into served /srv and separately installs the repository Caddyfile in the final image; the cited Caddy configuration constrains the represented static route methods.", "evidence": ["Dockerfile", "Caddyfile", "web/scripts/verify-docker-image.sh"], "checks": ["web_verify_caddy", "web_verify_docker_image"] }
      ]
    },
    {
      "id": "input_output_link_safety",
      "assertions": [
        { "id": "contact_link_contract", "status": "verified_static", "statement": "Repository checks validate the currently implemented contact-link transformation and generated-link contract for the bound bytes.", "evidence": ["web/src/lib/contact.ts", "web/scripts/verify-contact-links.mjs"], "checks": ["web_verify_data"] },
        { "id": "gateway_request_contract", "status": "verified_static", "statement": "The synthetic gateway implementation and tests enforce the cited request, route, and credential-verification contract in its tested local model.", "evidence": ["gateway/contracts/v1/security.json", "gateway/src/gateway.mjs", "gateway/src/security.mjs", "gateway/test/gateway.test.mjs"], "checks": ["web_verify_gateway"] }
      ]
    },
    {
