# World Hotlines CMS — example environment. Copy to `.env` locally (gitignored) or
# set these as Railway service variables. Never commit real values.

# Required at runtime: random secret of at least 32 characters (signs sessions and API-key indexes).
PAYLOAD_SECRET=replace_with_a_random_string_of_at_least_32_characters

# Postgres in production (Railway injects DATABASE_URL). Unset locally to use SQLite at data/cms.db.
# DATABASE_URL=postgresql://user:password@host:5432/database

# Canonical public origin. The CMS is only ever reached through Caddy at this origin
# (/admin, /cms/api, /_next); it drives cookies, CORS/CSRF, email links, and Stripe return URLs.
PUBLIC_SITE_URL=https://worldhotlines.org

# Member self-registration on /account. `closed` (default) still lets admins create users.
CMS_ACCOUNTS_REGISTRATION=closed
# Require members to verify their email before the account page works (needs SMTP_URL in production).
CMS_REQUIRE_EMAIL_VERIFICATION=0
# Active managed API keys a member may hold at once.
CMS_MAX_API_KEYS_PER_USER=5

# First boot only: creates this admin when the users table is empty. Remove afterwards.
# CMS_ADMIN_EMAIL=admin@example.org
# CMS_ADMIN_PASSWORD=replace_with_a_long_password

# Outbound email for verification and password resets. Without SMTP_URL, Payload logs emails to the console.
# SMTP_URL=smtps://user:password@smtp.example.org:465
SMTP_FROM_ADDRESS=no-reply@worldhotlines.org
SMTP_FROM_NAME=World Hotlines

# Stripe (optional; billing stays disabled without both). The key's test/live prefix sets the mode,
# and webhook events whose livemode disagrees are ignored. Register the endpoint
# https://worldhotlines.org/cms/api/stripe/webhooks for: checkout.session.*, customer.subscription.*,
# invoice.paid, invoice.payment_failed.
# STRIPE_SECRET_KEY=rk_test_replace_with_a_restricted_key
# STRIPE_WEBHOOK_SECRET=whsec_replace_with_the_endpoint_signing_secret
# Test double only: point the Stripe SDK at a loopback mock (never set in production).
# CMS_STRIPE_API_BASE=http://127.0.0.1:12111

# Managed API key issuance. Must equal the gateway's GATEWAY_PEPPER (32+ characters); unset disables issuance.
# GATEWAY_KEY_PEPPER=replace_with_an_independently_generated_secret_of_32_plus_chars

# Migration-only, set for a single `payload migrate` run: which mode a pre-existing Stripe
# customer id (from before the customers-per-mode migration) was actually created in. Unset
# defaults to test, matching the documented test-first rollout; set to live only when this
# deployment was already running live before that migration.
# CMS_LEGACY_STRIPE_CUSTOMER_MODE=live
