{
  "name": "world-emergency-hotlines-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Astro site for the World Emergency & Hotlines directory.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/build-static-data.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "data:build": "node scripts/build-static-data.mjs",
    "verify:data": "node scripts/verify-static-data.mjs && node scripts/verify-contact-links.mjs",
    "verify:links": "node scripts/verify-contact-links.mjs",
    "verify:search": "node scripts/verify-searchbox.mjs",
    "verify:discovery": "node scripts/verify-discovery-routes.mjs",
    "verify:all": "npm run verify:data && npm run verify:search && npm run verify:discovery",
    "db:init": "wrangler d1 execute world-hotlines --file=./db/schema.sql",
    "db:seed": "node db/seed.mjs > db/seed.sql && wrangler d1 execute world-hotlines --file=./db/seed.sql",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.4",
    "astro": "^7.1.3",
    "maplibre-gl": "^4.7.1",
    "tailwindcss": "^3.4.14"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@types/node": "^22.7.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.22",
    "typescript": "^5.6.3",
    "wrangler": "^4.114.0"
  }
}
