{
  "name": "world-emergency-hotlines-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Astro site for the World Emergency & Hotlines directory.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/build-static-data.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "data:build": "node scripts/build-static-data.mjs",
    "verify:data": "node scripts/verify-static-data.mjs && node scripts/verify-contact-links.mjs",
    "verify:links": "node scripts/verify-contact-links.mjs",
    "verify:search": "node scripts/verify-searchbox.mjs",
    "verify:discovery": "node scripts/verify-discovery-routes.mjs",
    "verify:pwa": "node scripts/verify-pwa.mjs",
    "generate:pwa": "node scripts/generate-pwa-cli.mjs",
    "generate:seo-images": "node scripts/generate-seo-images.mjs",
    "verify:seo-images": "node scripts/verify-seo-images.mjs",
    "verify:seo:dist": "node scripts/verify-seo.mjs && npm run verify:seo-images",
    "verify:seo": "npm run build && npm run verify:seo:dist",
    "verify:trust": "node scripts/verify-trust-foundation.mjs",
    "verify:finder": "node scripts/verify-guided-finder.mjs && node scripts/verify-traveler.mjs",
    "verify:api": "node scripts/verify-static-api.mjs",
    "verify:widget": "node scripts/verify-widget.mjs && node scripts/verify-widget-runtime.mjs",
    "verify:integration": "node scripts/verify-integration-readiness.mjs && node scripts/verify-subscription-contracts.mjs",
    "verify:gateway": "node scripts/verify-managed-gateway.mjs && node --test ../gateway/test/*.test.mjs",
    "verify:organizations": "node scripts/verify-organization-contracts.mjs",
    "verify:managed-widget-config": "node scripts/verify-managed-widget-config-contracts.mjs && node --test ../managed-widget-config/test/*.test.mjs",
    "verify:technical-health": "node scripts/verify-technical-health-contracts.mjs && node --test ../technical-health/test/*.test.mjs",
    "verify:assurance-packs": "node scripts/verify-assurance-pack-contracts.mjs && node --test ../assurance-packs/test/*.test.mjs",
    "verify:provider-claims": "node scripts/verify-provider-claim-contracts.mjs && node --test ../provider-claims/test/*.test.mjs",
    "verify:reviewer-work-queue": "node scripts/verify-reviewer-work-queue-contracts.mjs && node --test ../reviewer-work-queue/test/*.test.mjs",
    "verify:managed-api-plans": "node scripts/verify-managed-api-plan-contracts.mjs && node --test ../managed-api-plans/test/*.test.mjs",
    "verify:deprecation-proposals": "SOURCE_DATE_EPOCH=1786579200 node scripts/build-static-data.mjs && node scripts/verify-deprecation-proposal-contracts.mjs && node --test ../deprecation-proposals/test/*.test.mjs",
    "verify:evidence-backed-coverage": "SOURCE_DATE_EPOCH=1786579200 node scripts/build-static-data.mjs && node scripts/verify-evidence-backed-coverage-contracts.mjs && node --test ../evidence-backed-coverage/test/*.test.mjs",
    "verify:subscriptions": "SOURCE_DATE_EPOCH=1786579200 node scripts/build-static-data.mjs && node scripts/verify-subscription-contracts.mjs",
    "verify:release": "SOURCE_DATE_EPOCH=1786579200 node scripts/build-static-data.mjs && node scripts/verify-release-feeds.mjs && node scripts/verify-release-reproducibility.mjs && node scripts/verify-release-integrity.mjs && npm run verify:feeds:artifacts",
    "verify:feeds:unit": "node scripts/verify-release-feeds.mjs && node scripts/verify-dataset-append-only.mjs",
    "verify:feeds": "npm run verify:feeds:unit && SOURCE_DATE_EPOCH=1786579200 node scripts/build-static-data.mjs && node scripts/verify-release-integrity.mjs && npm run verify:feeds:artifacts",
    "verify:feeds:artifacts": "node scripts/verify-release-feed-artifacts.mjs && python3 scripts/verify-release-feed-semantics.py",
    "release:dataset:candidate": "node scripts/release-dataset-candidate.mjs",
    "verify:caddy": "sh scripts/verify-caddy.sh",
    "verify:all": "npm run verify:data && npm run verify:search && npm run verify:discovery && npm run verify:pwa && npm run verify:seo && npm run verify:trust && npm run verify:finder && npm run verify:api && npm run verify:widget && npm run verify:integration && npm run verify:gateway && npm run verify:organizations && npm run verify:managed-widget-config && npm run verify:technical-health && npm run verify:assurance-packs && npm run verify:provider-claims && npm run verify:reviewer-work-queue && npm run verify:managed-api-plans && npm run verify:deprecation-proposals && npm run verify:evidence-backed-coverage && npm run verify:release",
    "typecheck": "astro check",
    "monitor:seo:public": "python3 ../scripts/public_seo_monitor.py",
    "test:monitor:seo": "cd .. && python3 -m unittest tests.test_monitor_delta tests.test_public_seo_monitor tests.test_search_console_monitor tests.test_source_monitor tests.test_source_monitor_result tests.test_prior_artifact tests.test_seo_orchestrator tests.test_seo_workflow_contract tests.test_verification_workbench"
  },
  "dependencies": {
    "astro": "^7.2.1",
    "maplibre-gl": "^4.7.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.14"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.7.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.26",
    "typescript": "^5.6.3"
  }
}
