{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldhotlines.org/evidence-backed-coverage/v1/assessment.schema.json",
  "title": "Evidence-backed coverage assessment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "assessment_id", "dataset_sha256", "release", "footprint", "review", "dimensions", "limitations", "effects"],
  "properties": {
    "schema": { "const": "evidence-backed-coverage-assessment/v1" },
    "kind": { "const": "static_synthetic_reference" },
    "assessment_id": { "$ref": "evidence-input.schema.json#/$defs/id" },
    "dataset_sha256": { "$ref": "evidence-input.schema.json#/$defs/sha" },
    "release": { "$ref": "evidence-input.schema.json#/$defs/release" },
    "footprint": { "const": { "record_ids": ["weh_7539ec4b00fd54f5ae729d71", "weh_c3f7a20baee453f8ba87d0d3"], "record_count": 2 } },
    "review": { "$ref": "evidence-input.schema.json#/$defs/review" },
    "dimensions": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "prefixItems": [
        { "$ref": "#/$defs/channels" }, { "$ref": "#/$defs/geography" }, { "$ref": "#/$defs/hours" },
        { "$ref": "#/$defs/languages" }, { "$ref": "#/$defs/field" }, { "$ref": "#/$defs/recordedDate" }
      ],
      "items": false
    },
    "limitations": { "const": ["Retained structured observations support reviewed assertions on the recorded check date; human-reviewed interpretations are not mechanically byte-derived facts.", "Recorded evidence does not prove real-time availability, answering, eligibility, capacity, safety, outcomes, or universal geographic coverage.", "The recorded verification date dimension reports literal field presence only and makes no freshness or recency inference.", "This static synthetic assessment has no canonical-write, ranking, recommendation, comparison, intake, telemetry, outreach, commercial, pricing, billing, SLA, DPA, or security authority.", "Provider or claimant assertions are untrusted and cannot self-validate."] },
    "effects": { "type": "object", "additionalProperties": false, "required": ["canonical_mutation", "ranking_or_search_effect", "publication_authority", "commercial_activation"], "properties": { "canonical_mutation": { "const": false }, "ranking_or_search_effect": { "const": false }, "publication_authority": { "const": false }, "commercial_activation": { "const": false } } }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "dimension": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "numerator", "denominator", "unknown_count", "not_observed_count", "not_assessed_count", "coverage_state"],
      "properties": { "name": { "type": "string" }, "numerator": { "$ref": "#/$defs/count" }, "denominator": { "$ref": "#/$defs/count" }, "unknown_count": { "$ref": "#/$defs/count" }, "not_observed_count": { "$ref": "#/$defs/count" }, "not_assessed_count": { "$ref": "#/$defs/count" }, "coverage_state": { "enum": ["observed", "not_observed", "unknown", "not_assessed"] } },
      "oneOf": [
        { "$ref": "#/$defs/o2" }, { "$ref": "#/$defs/o1a1" },
        { "$ref": "#/$defs/u2" }, { "$ref": "#/$defs/u1o1" }, { "$ref": "#/$defs/u1n1" }, { "$ref": "#/$defs/u1a1" },
        { "$ref": "#/$defs/n2" }, { "$ref": "#/$defs/n1o1" }, { "$ref": "#/$defs/n1a1" }, { "$ref": "#/$defs/a2" }
      ]
    },
    "o2": { "type": "object", "properties": { "numerator": {"const":2}, "denominator":{"const":2}, "unknown_count":{"const":0}, "not_observed_count":{"const":0}, "not_assessed_count":{"const":0}, "coverage_state":{"const":"observed"} } },
    "o1a1": { "type": "object", "properties": { "numerator":{"const":1}, "denominator":{"const":1}, "unknown_count":{"const":0}, "not_observed_count":{"const":0}, "not_assessed_count":{"const":1}, "coverage_state":{"const":"observed"} } },
    "u2": { "type": "object", "properties": { "numerator":{"const":0}, "denominator":{"const":2}, "unknown_count":{"const":2}, "not_observed_count":{"const":0}, "not_assessed_count":{"const":0}, "coverage_state":{"const":"unknown"} } },
    "u1o1": { "type": "object", "properties": { "numerator":{"const":1}, "denominator":{"const":2}, "unknown_count":{"const":1}, "not_observed_count":{"const":0}, "not_assessed_count":{"const":0}, "coverage_state":{"const":"unknown"} } },
    "u1n1": { "type": "object", "properties": { "numerator":{"const":0}, "denominator":{"const":2}, "unknown_count":{"const":1}, "not_observed_count":{"const":1}, "not_assessed_count":{"const":0}, "coverage_state":{"const":"unknown"} } },
    "u1a1": { "type": "object", "properties": { "numerator":{"const":0}, "denominator":{"const":1}, "unknown_count":{"const":1}, "not_observed_count":{"const":0}, "not_assessed_count":{"const":1}, "coverage_state":{"const":"unknown"} } },
    "n2": { "type": "object", "properties": { "numerator":{"const":0}, "denominator":{"const":2}, "unknown_count":{"const":0}, "not_observed_count":{"const":2}, "not_assessed_count":{"const":0}, "coverage_state":{"const":"not_observed"} } },
    "n1o1": { "type": "object", "properties": { "numerator":{"const":1}, "denominator":{"const":2}, "unknown_count":{"const":0}, "not_observed_count":{"const":1}, "not_assessed_count":{"const":0}, "coverage_state":{"const":"not_observed"} } },
    "n1a1": { "type": "object", "properties": { "numerator":{"const":0}, "denominator":{"const":1}, "unknown_count":{"const":0}, "not_observed_count":{"const":1}, "not_assessed_count":{"const":1}, "coverage_state":{"const":"not_observed"} } },
    "a2": { "type": "object", "properties": { "numerator":{"const":0}, "denominator":{"const":0}, "unknown_count":{"const":0}, "not_observed_count":{"const":0}, "not_assessed_count":{"const":2}, "coverage_state":{"const":"not_assessed"} } },
    "channels": { "allOf": [{ "$ref": "#/$defs/dimension" }, { "type": "object", "properties": { "name": { "const": "channels" } } }] },
    "geography": { "allOf": [{ "$ref": "#/$defs/dimension" }, { "type": "object", "properties": { "name": { "const": "documented_geography" } } }] },
    "hours": { "allOf": [{ "$ref": "#/$defs/dimension" }, { "type": "object", "properties": { "name": { "const": "documented_hours" } } }] },
    "languages": { "allOf": [{ "$ref": "#/$defs/dimension" }, { "type": "object", "properties": { "name": { "const": "documented_languages" } } }] },
    "field": { "allOf": [{ "$ref": "#/$defs/dimension" }, { "type": "object", "properties": { "name": { "const": "field_evidence" } } }] },
    "recordedDate": { "allOf": [{ "$ref": "#/$defs/dimension" }, { "type": "object", "properties": { "name": { "const": "recorded_verification_date" } } }] }
  },
  "x-runtime-invariants": ["The standard Draft 2020-12 oneOf representation exhaustively encodes every valid state/count partition for this fixed two-record artifact", "Runtime additionally proves accepted review and exact artifact bytes"]
}
