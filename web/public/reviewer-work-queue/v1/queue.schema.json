{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.invalid/reviewer-work-queue/v1/queue.schema.json",
  "title": "Static synthetic reviewer work queue v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "queue_id", "queueing_actor", "ordering", "items", "effects"],
  "properties": {
    "schema": { "const": "reviewer-work-queue/v1" },
    "queue_id": { "type": "string", "pattern": "^rwq_syn_[a-z0-9_]{8,48}$" },
    "queueing_actor": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*\\.invalid$" },
    "ordering": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "meaning"],
      "properties": {
        "method": { "const": "administrative_sequence" },
        "meaning": { "const": "explicit_non_priority_non_ranking_order" }
      }
    },
    "items": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["item_id", "administrative_sequence", "claim_id", "claim_pin", "assigned_reviewer", "state"],
        "properties": {
          "item_id": { "type": "string", "pattern": "^rwi_syn_[a-z0-9_]{8,48}$" },
          "administrative_sequence": { "const": 1 },
          "claim_id": { "type": "string", "pattern": "^pclm_syn_[a-z0-9_]{8,48}$" },
          "claim_pin": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "assigned_reviewer": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*\\.invalid$" },
          "state": { "enum": ["queued", "assigned", "disposed"] }
        }
      }
    },
    "effects": { "$ref": "#/$defs/effects" }
  },
  "$defs": {
    "effects": {
      "type": "object", "additionalProperties": false,
      "required": ["canonical_mutation", "verified_status", "ranking_or_search_effect", "publication"],
      "properties": {
        "canonical_mutation": { "const": false }, "verified_status": { "const": false },
        "ranking_or_search_effect": { "const": false }, "publication": { "const": false }
      }
    }
  },
  "x-runtime-invariants": ["v1 contains exactly one item with administrative_sequence 1", "ordering never expresses or derives priority, urgency, geography, crisis intent, provider prominence, risk, or ranking", "claim pins bind exact validated provider-claim bytes", "queueing actor is a synthetic identity distinct from claimant, provider, and assigned reviewer and exactly matches the queued event actor", "assigned reviewer exactly matches the pinned provider review reviewer identity and cannot be substituted", "a supplied full disposition audit requires the item state to be disposed"]
}
