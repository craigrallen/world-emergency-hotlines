{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldhotlines.org/deprecation-proposals/v1/proposal.schema.json",
  "title": "Synthetic held deprecation or replacement proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "proposal_id",
    "kind",
    "state",
    "target",
    "intent",
    "evidence",
    "workflow",
    "reviewed_on",
    "approval",
    "uncertainty",
    "effects"
  ],
  "properties": {
    "schema": {
      "const": "deprecation-replacement-proposal/v1"
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^dpr_syn_[a-z0-9_]{8,48}$"
    },
    "kind": {
      "const": "deprecation"
    },
    "state": {
      "const": "held_pending_independent_approval"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stable_id",
        "canonical_sha256",
        "assessed_release_sha256",
        "release_id",
        "dataset_version",
        "artifact_index_path",
        "artifact_index_sha256",
        "records_artifact",
        "canonical_status"
      ],
      "properties": {
        "stable_id": {
          "$ref": "#/$defs/stable"
        },
        "canonical_sha256": {
          "$ref": "#/$defs/sha"
        },
        "assessed_release_sha256": {
          "$ref": "#/$defs/sha"
        },
        "release_id": {
          "$ref": "#/$defs/sha"
        },
        "dataset_version": {
          "$ref": "#/$defs/sha"
        },
        "artifact_index_path": {
          "const": "/release/v1/artifacts.json"
        },
        "artifact_index_sha256": {
          "$ref": "#/$defs/sha"
        },
        "records_artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "bytes"
          ],
          "properties": {
            "path": {
              "const": "/api/v1/records.json"
            },
            "sha256": {
              "$ref": "#/$defs/sha"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "canonical_status": {
          "type": "string",
          "enum": [
            "verified_web",
            "verified_authority",
            "verified_knowledge",
            "cross_referenced",
            "legacy_unverified",
            "disputed"
          ]
        }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition",
        "effective_date",
        "replacement_stable_id"
      ],
      "properties": {
        "transition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "to"
          ],
          "properties": {
            "from": {
              "type": "string",
              "enum": [
                "verified_web",
                "verified_authority",
                "verified_knowledge",
                "cross_referenced",
                "legacy_unverified",
                "disputed"
              ]
            },
            "to": {
              "const": "deprecated"
            }
          }
        },
        "effective_date": {
          "type": "string",
          "format": "date"
        },
        "replacement_stable_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/stable"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "claim_evidence_id",
          "classification",
          "kind",
          "locator_sha256",
          "summary"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^dpe_syn_[a-z0-9_]{8,48}$"
          },
          "claim_evidence_id": {
            "type": "string",
            "pattern": "^pev_syn_[a-z0-9_]{8,48}$"
          },
          "classification": {
            "const": "untrusted_claimant_evidence_reference"
          },
          "kind": {
            "const": "claimant_document_reference"
          },
          "locator_sha256": {
            "$ref": "#/$defs/sha"
          },
          "summary": {
            "$ref": "#/$defs/safe"
          }
        }
      },
      "uniqueItems": true
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "claim_pin",
        "claimant_identity",
        "provider_identity",
        "claim_evidence_ids",
        "queue_id",
        "queue_pin",
        "queue_item_id",
        "assigned_reviewer",
        "review_id",
        "review_pin",
        "decision",
        "conflict_state",
        "disposition_audit_id",
        "disposition_audit_pin",
        "disposition_event_head_sha256",
        "review_checkpoint_id",
        "review_checkpoint_pin",
        "reviewed_on",
        "lifecycle_evidence_authority"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "claim_pin": {
          "$ref": "#/$defs/sha"
        },
        "claimant_identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "provider_identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "claim_evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^pev_syn_[a-z0-9_]{8,48}$"
          }
        },
        "queue_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "queue_pin": {
          "$ref": "#/$defs/sha"
        },
        "queue_item_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "assigned_reviewer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "review_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "review_pin": {
          "$ref": "#/$defs/sha"
        },
        "decision": {
          "const": "needs_more_evidence"
        },
        "conflict_state": {
          "const": "no_conflict"
        },
        "disposition_audit_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "disposition_audit_pin": {
          "$ref": "#/$defs/sha"
        },
        "disposition_event_head_sha256": {
          "$ref": "#/$defs/sha"
        },
        "review_checkpoint_id": {
          "type": "string",
          "pattern": "^drc_syn_[a-z0-9_]{8,48}$"
        },
        "review_checkpoint_pin": {
          "$ref": "#/$defs/sha"
        },
        "reviewed_on": {
          "type": "string",
          "format": "date"
        },
        "lifecycle_evidence_authority": {
          "const": "untrusted_evidence_only_not_deprecation_authority"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "status",
        "approver_identity",
        "candidate_eligible"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "status": {
          "const": "not_requested"
        },
        "approver_identity": {
          "type": "null"
        },
        "candidate_eligible": {
          "const": false
        }
      }
    },
    "uncertainty": {
      "const": "material_uncertainty"
    },
    "effects": {
      "$ref": "#/$defs/effects"
    },
    "reviewed_on": {
      "type": "string",
      "format": "date"
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stable": {
      "type": "string",
      "pattern": "^weh_[0-9a-f]{24}$"
    },
    "safe": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z][A-Za-z0-9 .,'()&/-]*$"
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_mutation",
        "verified_status",
        "ranking_or_search_effect",
        "publication"
      ],
      "properties": {
        "canonical_mutation": {
          "const": false
        },
        "verified_status": {
          "const": false
        },
        "ranking_or_search_effect": {
          "const": false
        },
        "publication": {
          "const": false
        }
      }
    }
  },
  "x-runtime-invariants": [
    "Proposal-specific exact-byte claim, review, queue, disposition, and checkpoint validators bind every workflow",
    "Provider claims are untrusted lifecycle evidence only and never deprecation authority or candidate eligibility",
    "Canonical status is preserved exactly; replacement eligibility excludes deprecated, disputed, and replaced records",
    "Runtime recursively enforces the export leakage grammar"
  ]
}
