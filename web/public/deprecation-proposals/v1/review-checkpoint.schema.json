{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldhotlines.org/deprecation-proposals/v1/review-checkpoint.schema.json",
  "title": "Source-only synthetic review checkpoint v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "checkpoint_id",
    "reviewer_identity",
    "review_id",
    "decision",
    "conflict_state",
    "reviewed_on",
    "disposition_event_head_sha256",
    "authority"
  ],
  "properties": {
    "schema": { "const": "deprecation-synthetic-review-checkpoint/v1" },
    "checkpoint_id": { "type": "string", "pattern": "^drc_syn_[a-z0-9_]{8,48}$" },
    "reviewer_identity": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*\\.invalid$" },
    "review_id": { "type": "string", "pattern": "^prv_syn_[a-z0-9_]{8,48}$" },
    "decision": { "const": "needs_more_evidence" },
    "conflict_state": { "const": "no_conflict" },
    "reviewed_on": { "type": "string", "format": "date" },
    "disposition_event_head_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "authority": { "const": "synthetic_review_date_binding_only" }
  }
}
