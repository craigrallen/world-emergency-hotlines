{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://worldhotlines.org/gateway/v1/key-record.schema.json","title":"Managed gateway stored key record (never a raw secret)","type":"object","additionalProperties":false,"required":["id","verifier","state","not_before","expires_at","api_majors","permissions","quota","synthetic"],"properties":{"id":{"type":"string","pattern":"^[a-z0-9]{12}$"},"verifier":{"type":"string","pattern":"^[A-Za-z0-9_-]{43}$"},"state":{"enum":["active","revoked","expired"]},"not_before":{"type":["string","null"],"format":"date-time"},"expires_at":{"type":["string","null"],"format":"date-time"},"api_majors":{"type":"array","items":{"const":1},"minItems":1,"maxItems":1,"uniqueItems":true},"permissions":{"type":"array","items":{"enum":["manifest","records","resolver"]},"minItems":1,"maxItems":3,"uniqueItems":true},"quota":{"type":"object","description":"Token rate per second and integer burst. Runtime validation additionally requires burst <= rate * 86400, so a full refill is always representable by RateLimit-Reset.","additionalProperties":false,"required":["rate","burst"],"properties":{"rate":{"type":"number","exclusiveMinimum":0,"maximum":1000},"burst":{"type":"integer","minimum":1,"maximum":10000}}},"synthetic":{"type":"boolean"}}}
