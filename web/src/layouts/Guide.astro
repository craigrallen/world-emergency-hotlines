---
import Base from './Base.astro';
import { breadcrumbJsonLd, SITE_NAME } from '../lib/seo';
import { SITE_URL } from '../lib/site';

interface Props {
  title: string;
  description: string;
  researched: string;
}

const { title, description, researched } = Astro.props;
const site = Astro.site ?? SITE_URL;
const url = new URL(Astro.url.pathname, site).toString();
const breadcrumbs = breadcrumbJsonLd([
  { name: 'Home', path: '/' },
  { name: 'Guides', path: '/guides' },
  { name: title, path: Astro.url.pathname },
], site);
const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: '2026-08-15',
  dateModified: '2026-08-15',
  url,
  isPartOf: {
    '@type': 'WebSite',
    name: SITE_NAME,
    url: new URL('/', site).toString(),
  },
};
---

<Base title={`${title} · Hotlines guide`} description={description} jsonLd={[breadcrumbs, article]}>
  <nav class="mx-auto mb-6 flex max-w-3xl items-center gap-2 text-xs text-fg-muted" aria-label="Breadcrumb">
    <a href="/" class="hover:text-fg">Home</a>
    <span aria-hidden="true">›</span>
    <a href="/guides" class="hover:text-fg">Guides</a>
    <span aria-hidden="true">›</span>
    <span class="truncate text-fg" aria-current="page">{title}</span>
  </nav>

  <article class="guide prose mx-auto max-w-3xl text-fg">
    <header class="mb-10 border-b border-border pb-7">
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-accent">World Hotlines guide</p>
      <h1 class="text-4xl font-semibold tracking-tight text-fg sm:text-5xl">{title}</h1>
      <p class="mt-4 text-lg leading-8 text-fg-muted">{description}</p>
      <p class="mt-4 text-sm text-fg-muted">Last researched {researched}</p>
    </header>
    <slot />
  </article>
</Base>

<style>
  .guide :global(h2) { margin-top: 2.5rem; font-size: 1.5rem; font-weight: 600; line-height: 1.3; color: rgb(var(--fg)); }
  .guide :global(h3) { margin-top: 1.75rem; font-size: 1.125rem; font-weight: 600; color: rgb(var(--fg)); }
  .guide :global(p), .guide :global(li) { line-height: 1.75; color: rgb(var(--fg-muted)); }
  .guide :global(p) { margin-top: 1rem; }
  .guide :global(ul), .guide :global(ol) { margin-top: 1rem; padding-left: 1.5rem; }
  .guide :global(ul) { list-style: disc; }
  .guide :global(ol) { list-style: decimal; }
  .guide :global(li + li) { margin-top: .45rem; }
  .guide :global(a) { color: rgb(var(--accent)); text-decoration: underline; text-underline-offset: .16em; }
  .guide :global(blockquote) { margin: 1.75rem 0; border-left: 4px solid rgb(var(--danger)); border-radius: 0 1rem 1rem 0; background: rgb(var(--danger) / .1); padding: 1rem 1.25rem; }
  .guide :global(blockquote p) { margin: 0; color: rgb(var(--fg)); }
  .guide :global(code) { border-radius: .3rem; background: rgb(var(--bg-soft)); padding: .1rem .35rem; color: rgb(var(--fg)); font-size: .9em; }
  .guide :global(strong) { color: rgb(var(--fg)); }
</style>
