---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EmergencyBanner from '../components/EmergencyBanner.astro';
import { DEFAULT_LOCALE, DICTIONARIES, isRTL, t, type Locale } from '../lib/i18n';
import { serializeJsonLd } from '../lib/json-ld.mjs';
import { SITE_URL } from '../lib/site';
import { SITE_NAME, SOCIAL_IMAGE_ALT, SOCIAL_IMAGE_PATH } from '../lib/seo';

type JsonLdObject = Record<string, unknown>;

interface Props {
  title?: string;
  description?: string;
  hideBanner?: boolean;
  bleed?: boolean;
  locale?: Locale;
  robots?: 'index,follow' | 'noindex,follow';
  canonical?: boolean;
  jsonLd?: JsonLdObject | JsonLdObject[];
}

const {
  title = 'World Emergency & Hotlines',
  description = 'Emergency and crisis hotline listings across countries and territories worldwide. Coverage varies; check the relevant country page.',
  hideBanner = false,
  bleed = false,
  locale = DEFAULT_LOCALE,
  robots = 'index,follow',
  canonical: includeCanonical = true,
  jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE_URL).toString();
const emitCanonical = includeCanonical && robots === 'index,follow';
const socialImage = new URL(SOCIAL_IMAGE_PATH, Astro.site ?? SITE_URL).toString();
const jsonLdItems = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const dir = isRTL(locale) ? 'rtl' : 'ltr';
const bootPayload = JSON.stringify({ defaultLocale: locale, dictionaries: DICTIONARIES });
---

<!doctype html>
<html lang={locale} dir={dir} class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f5f7fb" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />

    {emitCanonical && <link rel="canonical" href={canonical} />}
    <link rel="alternate" type="application/feed+json" title="World Hotlines releases (JSON Feed)" href="/feeds/releases.json" />
    <link rel="alternate" type="application/rss+xml" title="World Hotlines releases (RSS)" href="/feeds/releases.rss" />
    <link rel="alternate" type="application/atom+xml" title="World Hotlines releases (Atom)" href="/feeds/releases.atom" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <script is:inline src="/pwa-register.js" defer></script>

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {emitCanonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={SOCIAL_IMAGE_ALT} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={SOCIAL_IMAGE_ALT} />
    {jsonLdItems.map((item) => <script is:inline type="application/ld+json" set:html={serializeJsonLd(item)} />)}

    <script is:inline define:vars={{ bootPayload }}>
      const boot = JSON.parse(bootPayload);
      const localeOrder = ['en', 'es', 'fr', 'de', 'pt-BR', 'ar', 'hi', 'zh-CN', 'ja', 'ru'];
      const rtlLocales = new Set(['ar']);
      const root = document.documentElement;
      const themeMeta = document.querySelector('meta[name="theme-color"]');

      const resolveLocale = (value) => {
        if (!value) return boot.defaultLocale;
        const exact = localeOrder.find((entry) => entry.toLowerCase() === value.toLowerCase());
        if (exact) return exact;
        const base = value.toLowerCase().split('-')[0];
        return localeOrder.find((entry) => entry.toLowerCase().split('-')[0] === base) || boot.defaultLocale;
      };

      const formatValue = (locale, value) => {
        if (typeof value === 'number') return new Intl.NumberFormat(locale).format(value);
        return String(value ?? '');
      };

      const translate = (locale, key, vars = {}) => {
        const dict = boot.dictionaries[locale] || boot.dictionaries[boot.defaultLocale] || {};
        const template = dict[key] || boot.dictionaries[boot.defaultLocale]?.[key] || key;
        return template.replace(/\{\{(.*?)\}\}/g, (_, raw) => formatValue(locale, vars[raw.trim()]));
      };

      const applyLocale = (locale) => {
        const resolved = resolveLocale(locale);
        root.lang = resolved;
        root.dir = rtlLocales.has(resolved) ? 'rtl' : 'ltr';
        root.dataset.locale = resolved;
        localStorage.setItem('weh-locale', resolved);

        document.querySelectorAll('[data-i18n]').forEach((el) => {
          el.textContent = translate(resolved, el.getAttribute('data-i18n') || '');
        });
        document.querySelectorAll('[data-i18n-html]').forEach((el) => {
          el.innerHTML = translate(resolved, el.getAttribute('data-i18n-html') || '');
        });
        document.querySelectorAll('[data-i18n-placeholder]').forEach((el) => {
          el.setAttribute('placeholder', translate(resolved, el.getAttribute('data-i18n-placeholder') || ''));
        });
        document.querySelectorAll('[data-i18n-title]').forEach((el) => {
          el.setAttribute('title', translate(resolved, el.getAttribute('data-i18n-title') || ''));
        });
        document.querySelectorAll('[data-i18n-aria-label]').forEach((el) => {
          el.setAttribute('aria-label', translate(resolved, el.getAttribute('data-i18n-aria-label') || ''));
        });
        document.querySelectorAll('[data-i18n-template]').forEach((el) => {
          const key = el.getAttribute('data-i18n-template') || '';
          const raw = el.getAttribute('data-i18n-args') || '{}';
          try {
            const parsed = JSON.parse(raw);
            el.textContent = translate(resolved, key, parsed);
          } catch {
            el.textContent = translate(resolved, key);
          }
        });

        window.__WEH__ = { ...window.__WEH__, locale: resolved, t: (key, vars) => translate(resolved, key, vars), dictionaries: boot.dictionaries };
        window.dispatchEvent(new CustomEvent('weh:locale-changed', { detail: resolved }));
      };

      const getPreferredTheme = () => {
        const saved = localStorage.getItem('weh-theme');
        if (saved === 'light' || saved === 'dark' || saved === 'system') return saved;
        return 'system';
      };

      const getAppliedTheme = (theme) => theme === 'system'
        ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
        : theme;

      const applyTheme = (theme) => {
        const preference = theme || getPreferredTheme();
        const applied = getAppliedTheme(preference);
        root.dataset.themePreference = preference;
        root.dataset.theme = applied;
        localStorage.setItem('weh-theme', preference);
        if (themeMeta) themeMeta.setAttribute('content', applied === 'dark' ? '#0f172a' : '#f5f7fb');
        window.dispatchEvent(new CustomEvent('weh:theme-changed', { detail: { preference, applied } }));
      };

      window.addEventListener('weh:set-locale', (event) => {
        const locale = event.detail;
        const url = new URL(window.location.href);
        url.searchParams.set('lang', resolveLocale(locale));
        history.replaceState({}, '', url.toString());
        applyLocale(locale);
      });

      window.addEventListener('weh:set-theme', (event) => {
        applyTheme(event.detail);
      });

      const localeFromUrl = new URL(window.location.href).searchParams.get('lang');
      const savedLocale = localStorage.getItem('weh-locale');
      const browserLocale = navigator.languages?.[0] || navigator.language;
      applyLocale(localeFromUrl || savedLocale || browserLocale || boot.defaultLocale);
      applyTheme(getPreferredTheme());
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
        if ((root.dataset.themePreference || 'system') === 'system') applyTheme('system');
      });
    </script>
  </head>

  <body class="h-full min-h-[100dvh] flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only fixed left-4 top-4 z-[60] rounded-md bg-accent px-3 py-1.5 text-sm text-accent-contrast" data-i18n="common.skipToContent">
      {t(locale, 'common.skipToContent')}
    </a>

    {!hideBanner && <EmergencyBanner locale={locale} />}
    <Header locale={locale} />

    <main id="main" class={bleed ? 'flex-1' : 'flex-1 mx-auto w-full max-w-6xl px-4 py-10 sm:px-6 lg:px-8'}>
      <slot />
    </main>

    <Footer locale={locale} />
    <div data-offline-status role="status" aria-live="polite" hidden class="fixed bottom-4 left-1/2 z-50 w-[min(42rem,calc(100%-2rem))] -translate-x-1/2 rounded-xl border border-amber-400/60 bg-bg-elev px-4 py-3 text-sm text-fg shadow-lg">
      <span data-offline-message></span> <a href="/offline.html" class="font-medium text-accent underline">Offline limitations</a>
    </div>
  </body>
</html>
