---
// Client-side search + filter box.
// Phase 1: substring + token scoring against /data/search-index.json.
// Supports optional quick-filter chips: verified-only, has-chat, has-sms, per-category.
---

<div class="space-y-3">
  <!-- Search bar -->
  <div class="card relative p-2 shadow-glow">
    <form id="hotline-search-form" class="flex items-center gap-2" role="search">
      <svg viewBox="0 0 24 24" fill="none" class="ml-3 h-5 w-5 shrink-0 text-fg-muted" aria-hidden="true" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8" />
        <path d="m21 21-4.3-4.3" />
      </svg>
      <input
        id="hotline-search-input"
        type="search"
        placeholder="Search: country, category, or service name…"
        class="flex-1 bg-transparent px-1 py-3 text-base text-fg placeholder:text-fg-muted focus:outline-none"
        autocomplete="off"
        aria-label="Search hotlines"
        aria-controls="search-results"
      />
      <button type="submit" class="btn-primary mr-1 hidden sm:inline-flex">Search</button>
    </form>

    <!-- Inline results dropdown -->
    <div
      id="search-results"
      class="absolute left-0 right-0 top-full z-20 mt-2 hidden overflow-hidden rounded-2xl border border-border bg-bg-elev shadow-2xl"
      role="listbox"
      aria-live="polite"
    ></div>
  </div>

  <!-- Parsed-intent chips -->
  <div id="search-intent-chips" class="hidden flex-wrap gap-2" aria-live="polite"></div>

  <!-- Quick-filter chips -->
  <div id="search-filters" class="flex flex-wrap gap-2">
    <button
      class="filter-chip chip border-border/60 text-fg-muted hover:border-accent/50 hover:text-fg text-xs"
      data-filter="verified"
      aria-pressed="false"
      title="Only show hotlines that have been verified against official sources"
    >
      Verified only
    </button>
    <button
      class="filter-chip chip border-border/60 text-fg-muted hover:border-accent/50 hover:text-fg text-xs"
      data-filter="chat"
      aria-pressed="false"
      title="Only show hotlines with online chat"
    >
      Online chat
    </button>
    <button
      class="filter-chip chip border-border/60 text-fg-muted hover:border-accent/50 hover:text-fg text-xs"
      data-filter="sms"
      aria-pressed="false"
      title="Only show hotlines with SMS/text access"
    >
      SMS / text
    </button>
    <!-- Quick category shortcuts -->
    {(
      [
        { slug: 'suicide_crisis',    label: '🆘 Crisis' },
        { slug: 'child_protection',  label: '🧒 Child' },
        { slug: 'domestic_violence', label: '🛡️ DV' },
        { slug: 'mental_health',     label: '🧠 Mental health' },
      ] as { slug: string; label: string }[]
    ).map(({ slug, label }) => (
      <button
        class="filter-chip chip border-border/60 text-fg-muted hover:border-accent/50 hover:text-fg text-xs"
        data-filter={`cat:${slug}`}
        aria-pressed="false"
      >
        {label}
      </button>
    ))}
  </div>

  <!-- Fallback guidance (shown when results are empty or search is blank) -->
  <div id="search-fallback" class="hidden rounded-2xl border border-border bg-bg-elev/30 p-5 text-sm">
    <p class="font-semibold text-fg mb-2">No exact match?</p>
    <ul class="space-y-1.5 text-fg-muted text-xs">
      <li>
        <span class="mr-1" aria-hidden="true">🌍</span>
        <a href="/map" class="text-accent hover:underline">Open the world map</a>
        — click any country to see all local numbers.
      </li>
      <li>
        <span class="mr-1" aria-hidden="true">📋</span>
        <a href="/categories" class="text-accent hover:underline">Browse by category</a>
        — crisis, child protection, domestic violence, and more.
      </li>
      <li>
        <span class="mr-1" aria-hidden="true">✈️</span>
        <strong class="text-fg">Travelling?</strong>
        In most countries <span class="font-mono text-fg">112</span> reaches emergency services.
        US/Canada: <span class="font-mono text-fg">911</span>. UK: <span class="font-mono text-fg">999</span>. AU: <span class="font-mono text-fg">000</span>.
      </li>
    </ul>
  </div>
</div>

<script>
  import {
    buildNoResultsGuidance,
    buildOverflowSummary,
    buildResultSummary,
    describeActiveFilters,
    docMatchesQueryFilters,
    hasMeaningfulQuery,
    parseSearchQuery,
    scoreDoc,
  } from '../lib/search.js';

  type Doc = {
    country_code: string;
    country_name: string;
    region: string | null;
    name: string;
    organization: string | null;
    category: string;
    numbers: string[];
    languages: string[];
    verified: boolean;
    verification_status: string;
    has_chat: boolean;
    has_sms: boolean;
  };

  const form    = document.getElementById('hotline-search-form') as HTMLFormElement | null;
  const input   = document.getElementById('hotline-search-input') as HTMLInputElement | null;
  const panel   = document.getElementById('search-results') as HTMLDivElement | null;
  const fallback = document.getElementById('search-fallback') as HTMLDivElement | null;
  const filterBar = document.getElementById('search-filters') as HTMLDivElement | null;
  const intentChips = document.getElementById('search-intent-chips') as HTMLDivElement | null;

  if (!form || !input || !panel) throw new Error('search: missing DOM');

  // Active filters
  const activeFilters = new Set<string>();

  // Watch filter chips
  filterBar?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('[data-filter]') as HTMLButtonElement | null;
    if (!btn) return;
    const f = btn.dataset.filter!;
    if (activeFilters.has(f)) {
      activeFilters.delete(f);
      btn.setAttribute('aria-pressed', 'false');
      btn.classList.remove('border-accent/60', 'bg-accent/10', 'text-accent');
    } else {
      activeFilters.add(f);
      btn.setAttribute('aria-pressed', 'true');
      btn.classList.add('border-accent/60', 'bg-accent/10', 'text-accent');
    }
    onChange();
  });

  let docs: Doc[] | null = null;
  let fetching: Promise<Doc[]> | null = null;

  async function loadDocs(): Promise<Doc[]> {
    if (docs) return docs;
    if (fetching) return fetching;
    fetching = fetch('/data/search-index.json')
      .then((r) => r.json())
      .then((d: Doc[]) => { docs = d; return d; });
    return fetching;
  }

  function applyFilters(doc: Doc): boolean {
    for (const f of activeFilters) {
      if (f === 'verified' && !doc.verified) return false;
      if (f === 'chat'     && !doc.has_chat)  return false;
      if (f === 'sms'      && !doc.has_sms)   return false;
      if (f.startsWith('cat:') && doc.category !== f.slice(4)) return false;
    }
    return true;
  }

  function escape(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function renderIntentChips(parsedQuery: ReturnType<typeof parseSearchQuery>) {
    if (!intentChips) return;

    const chips: string[] = [];

    if (parsedQuery.intent?.country) {
      chips.push(`<span class="chip border-accent/30 bg-accent/10 text-accent text-xs">Country: ${escape(parsedQuery.intent.country.label)}</span>`);
    }

    if (parsedQuery.filters.includes('chat')) {
      chips.push('<span class="chip border-border/60 bg-bg-elev text-fg-muted text-xs">Chat only</span>');
    }

    if (parsedQuery.filters.includes('sms')) {
      chips.push('<span class="chip border-border/60 bg-bg-elev text-fg-muted text-xs">SMS / text</span>');
    }

    if (parsedQuery.intent?.category) {
      chips.push(`<span class="chip border-border/60 bg-bg-elev text-fg-muted text-xs">Category: ${escape(parsedQuery.intent.category.label)}</span>`);
    }

    if (chips.length === 0) {
      intentChips.innerHTML = '';
      intentChips.classList.add('hidden');
      return;
    }

    intentChips.innerHTML = chips.join('');
    intentChips.classList.remove('hidden');
  }

  function getUiFilters(): string[] {
    return Array.from(activeFilters);
  }

  function matchesUiFilters(doc: Doc, uiFilters: string[]) {
    for (const filter of uiFilters) {
      if (filter === 'verified' && !doc.verified) return false;
      if (filter === 'chat' && !doc.has_chat) return false;
      if (filter === 'sms' && !doc.has_sms) return false;
      if (filter.startsWith('cat:') && doc.category !== filter.slice(4)) return false;
    }

    return true;
  }

  function buildRelaxedAlternatives(allDocs: Doc[], parsedQuery: ReturnType<typeof parseSearchQuery>, uiFilters: string[]) {
    const needsRelaxing = parsedQuery.filters.includes('chat') || parsedQuery.filters.includes('sms') || uiFilters.includes('chat') || uiFilters.includes('sms');
    if (!needsRelaxing) return { count: 0, summary: '' };

    const relaxedUiFilters = uiFilters.filter((filter) => filter !== 'chat' && filter !== 'sms');
    const relaxedParsedQuery = {
      ...parsedQuery,
      filters: parsedQuery.filters.filter((filter) => filter !== 'chat' && filter !== 'sms'),
    };

    const relaxedResults = allDocs
      .filter((doc) => matchesUiFilters(doc, relaxedUiFilters))
      .filter((doc) => docMatchesQueryFilters(doc, relaxedParsedQuery));

    if (relaxedResults.length === 0) return { count: 0, summary: '' };

    const verifiedCount = relaxedResults.filter((doc) => doc.verified).length;
    const filters = describeActiveFilters(relaxedUiFilters);
    const bits: string[] = [];

    if (verifiedCount > 0) bits.push(`${verifiedCount} verified`);
    if (filters.includes('verified')) bits.push('matching your verified-only filter');
    bits.push('without that channel requirement');

    return {
      count: relaxedResults.length,
      summary: bits.join(' '),
    };
  }

  const CHANNEL_BADGES: Record<string, string> = {
    verified_web: '<span class="text-success text-[9px]">✓ verified</span>',
    verified_authority: '<span class="text-success text-[9px]">✓ verified</span>',
    verified_knowledge: '<span class="text-success text-[9px]">✓ verified</span>',
    cross_referenced: '<span class="text-accent text-[9px]">↔ cross-ref</span>',
  };

  function render(results: Doc[], q: string, parsedQuery: ReturnType<typeof parseSearchQuery>, allDocs: Doc[]) {
    if (!panel) return;

    const hasQuery = q.trim().length > 0;
    const hasFilters = activeFilters.size > 0;
    const uiFilters = getUiFilters();

    if (results.length === 0 && (hasQuery || hasFilters)) {
      const relaxed = buildRelaxedAlternatives(allDocs, parsedQuery, uiFilters);
      const noResults = buildNoResultsGuidance({
        parsedQuery,
        uiFilters,
        docs: allDocs,
        relaxedCount: relaxed.count,
        relaxedSummary: relaxed.summary,
      });
      const suggestionList = (noResults.suggestions ?? [])
        .map((item) => `<li>${escape(item)}</li>`)
        .join('');

      panel.innerHTML = `
        <div class="px-4 py-4 text-sm text-fg-muted space-y-2">
          <p class="text-fg">${escape(noResults.title)}</p>
          <p class="text-xs">${escape(noResults.detail)}</p>
          ${suggestionList ? `<ul class="list-disc space-y-1 pl-4 text-xs text-fg-muted">${suggestionList}</ul>` : ''}
        </div>`;
      panel.classList.remove('hidden');
      fallback?.classList.remove('hidden');
      return;
    }

    if (results.length === 0) {
      panel.classList.add('hidden');
      return;
    }

    fallback?.classList.add('hidden');
    panel.innerHTML = `
      <div class="border-b border-border/60 px-4 py-3 text-sm text-fg">
        ${escape(buildResultSummary(results, parsedQuery, uiFilters))}
      </div>
    ` + results
      .slice(0, 14)
      .map((r) => {
        const primary = r.numbers[0] ?? '';
        const badge = CHANNEL_BADGES[r.verification_status] ?? '';
        const channelIcons = [
          r.has_chat ? '<span class="text-[9px] text-fg-muted" title="Online chat">💬</span>' : '',
          r.has_sms  ? '<span class="text-[9px] text-fg-muted" title="SMS">📱</span>' : '',
        ].filter(Boolean).join('');
        return `
          <a href="/country/${r.country_code.toLowerCase()}" class="flex items-center justify-between gap-4 border-b border-border/60 px-4 py-3 last:border-b-0 hover:bg-bg/60">
            <div class="min-w-0">
              <div class="truncate text-sm font-medium text-fg">${escape(r.name)}</div>
              <div class="flex items-center gap-1.5 flex-wrap">
                <span class="truncate text-xs text-fg-muted">${escape(r.country_name)} · ${r.category.replace(/_/g, ' ')}</span>
                ${badge}
                ${channelIcons}
              </div>
            </div>
            ${primary ? `<div class="shrink-0 font-mono text-sm text-accent">${escape(primary)}</div>` : ''}
          </a>`;
      })
      .join('');

    if (results.length > 14) {
      panel.innerHTML += `<div class="px-4 py-2 text-xs text-fg-muted border-t border-border/60">${escape(buildOverflowSummary(results.length - 14, parsedQuery, uiFilters))}</div>`;
    }

    panel.classList.remove('hidden');
  }

  let debounce = 0;

  async function onChange() {
    const q = input?.value.trim() ?? '';
    const hasFilters = activeFilters.size > 0;

    if (!q && !hasFilters) {
      panel?.classList.add('hidden');
      intentChips?.classList.add('hidden');
      if (intentChips) intentChips.innerHTML = '';
      fallback?.classList.remove('hidden');
      return;
    }

    fallback?.classList.add('hidden');
    window.clearTimeout(debounce);
    debounce = window.setTimeout(async () => {
      const d = await loadDocs();
      const parsedQuery = parseSearchQuery(q, d);
      renderIntentChips(parsedQuery);
      const hasQueryTokens = q && hasMeaningfulQuery(q);
      const hasIntentFilters = parsedQuery.filters.length > 0;
      let ranked: Doc[];

      if (q && (hasQueryTokens || hasIntentFilters)) {
        ranked = d
          .filter(applyFilters)
          .filter((doc) => docMatchesQueryFilters(doc, parsedQuery))
          .map((doc) => ({ doc, score: hasQueryTokens ? scoreDoc(doc, parsedQuery) : (doc.verified ? 1 : 0) }))
          .filter((x) => x.score > 0 || (!hasQueryTokens && hasIntentFilters))
          .sort((a, b) => b.score - a.score)
          .map((x) => x.doc);
      } else if (q) {
        ranked = [];
      } else {
        // Filters only — show top verified results
        ranked = d
          .filter(applyFilters)
          .filter((doc) => doc.verified)
          .slice(0, 20);
      }

      render(ranked, q, parsedQuery, d);
    }, 90);
  }

  input.addEventListener('input', onChange);
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    onChange();
  });
  document.addEventListener('click', (e) => {
    if (!form.contains(e.target as Node) && !panel.contains(e.target as Node)) {
      panel.classList.add('hidden');
    }
  });
  input.addEventListener('focus', () => {
    const q = input.value.trim();
    const hasFilters = activeFilters.size > 0;
    if (q || hasFilters) panel.classList.remove('hidden');
    else fallback?.classList.remove('hidden');
  });

  // Show fallback initially
  fallback?.classList.remove('hidden');
</script>
