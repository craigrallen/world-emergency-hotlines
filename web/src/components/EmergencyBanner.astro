---
import Icon from './Icon.astro';
import { t, type Locale } from '../lib/i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' as Locale } = Astro.props;
---

<aside id="emergency-banner" class="emergency-strip sticky top-0 z-50 shadow-lg" role="region" aria-label={t(locale, 'banner.aria')} data-i18n-aria-label="banner.aria">
  <div class="flex min-w-0 items-center gap-3">
    <Icon name="alert" class="h-5 w-5 shrink-0 animate-pulse-slow" />
    <p class="min-w-0 leading-snug">
      <strong class="font-semibold" data-i18n="banner.title">{t(locale, 'banner.title')}</strong>
      <span class="ml-1 opacity-90" data-i18n="banner.body">
        {t(locale, 'banner.body')}
      </span>
    </p>
  </div>

  <a href="/countries" aria-label={t(locale, 'banner.cta')} class="inline-flex shrink-0 items-center gap-1 rounded-full bg-white/15 px-2.5 py-1 text-xs font-medium transition hover:bg-white/25 sm:gap-1.5 sm:px-3">
    <span data-i18n="banner.cta">{t(locale, 'banner.cta')}</span>
    <Icon name="chevron-right" class="h-3.5 w-3.5" />
  </a>
</aside>
