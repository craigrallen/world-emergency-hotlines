---
import type { Hotline } from '../lib/types';
import { VERIFICATION_LABELS } from '../lib/types';
import { getFreshnessInfo } from '../lib/data';
import { buildHotlineIssueUrl } from '../lib/issues.js';
import Icon from './Icon.astro';

interface Props {
  hotline: Hotline;
  country?: string;
  showCountry?: boolean;
}

const { hotline, country, showCountry = true } = Astro.props;

const badgeTone: Record<string, string> = {
  verified_web: 'bg-success/15 text-success border-success/40',
  verified_authority: 'bg-success/15 text-success border-success/40',
  verified_knowledge: 'bg-success/10 text-success border-success/30',
  cross_referenced: 'bg-accent/15 text-accent border-accent/40',
  legacy_unverified: 'bg-fg-muted/15 text-fg-muted border-fg-muted/30',
  disputed: 'bg-danger/15 text-danger border-danger/40',
  deprecated: 'bg-fg-muted/15 text-fg-muted border-fg-muted/30',
};
const tone = badgeTone[hotline.verification_status] ?? badgeTone.legacy_unverified;
const statusLabel = VERIFICATION_LABELS[hotline.verification_status] ?? hotline.verification_status.replace(/_/g, ' ');

const statusTooltip: Record<string, string> = {
  verified_web: 'Details appeared on the organisation\'s official website when checked; this is not a live availability check',
  verified_authority: 'Details appeared in an authoritative source when checked; this is not a live availability check',
  verified_knowledge: 'Checked against a trusted reference source, not necessarily the provider\'s own page',
  cross_referenced: 'Found in multiple independent sources; not yet confirmed against the provider or responsible authority',
  legacy_unverified: 'From a legacy dataset — please double-check before calling',
  disputed: 'Conflicting information found — treat with caution',
  deprecated: 'This service may no longer be active',
};
const tooltip = statusTooltip[hotline.verification_status] ?? '';

function cleanNumber(raw: string): string {
  let n = String(raw).trim();
  while (n.split('(').length - 1 > n.split(')').length - 1) {
    const i = n.lastIndexOf(' (');
    if (i <= 0) break;
    n = n.slice(0, i).trim();
  }
  while (n.split(')').length - 1 > n.split('(').length - 1 && n.endsWith(')')) n = n.slice(0, -1).trim();
  if (/^\d+\)/.test(n) && !n.includes('(')) n = '(' + n;
  return n;
}

const numbers = [...hotline.voice_numbers, ...hotline.short_codes].map(cleanNumber).filter((n) => n.length > 0);
const hasSms = hotline.sms_numbers.length > 0 || hotline.text_numbers.length > 0;
const hasChat = !!hotline.chat_url;
const hasEmail = !!hotline.email;
const freshness = getFreshnessInfo(hotline);
const freshnessColour = freshness.level === 'fresh' ? 'text-success' : freshness.level === 'ok' ? 'text-success/70' : freshness.level === 'stale' ? 'text-accent' : 'text-fg-muted/60';
const sources = hotline.sources?.filter(Boolean).slice(0, 2) ?? [];
const linkedSources = sources.filter((source) => /^https?:\/\//i.test(source));
const serviceArea = hotline.geography && country && hotline.geography.trim().toLowerCase() !== country.trim().toLowerCase()
  ? hotline.geography
  : null;
const reportIssueUrl = buildHotlineIssueUrl(hotline, country);
---

<article class="card p-5 hover:border-accent/50">
  <header class="mb-3 flex items-start justify-between gap-3">
    <div class="min-w-0">
      <h3 class="truncate text-base font-semibold text-fg">{hotline.name}</h3>
      {hotline.organization && hotline.organization !== hotline.name && <p class="truncate text-xs text-fg-muted">{hotline.organization}</p>}
    </div>
    <span class={`chip shrink-0 border ${tone} cursor-help`} title={tooltip} aria-label={`Verification: ${statusLabel}. ${tooltip}`}>
      {statusLabel}
    </span>
  </header>

  {numbers.length > 0 && (
    <ul class="mb-3 flex flex-wrap gap-2">
      {numbers.map((n) => (
        <li>
          <a href={`tel:${n.replace(/\s+/g, '')}`} class="inline-flex items-center gap-1.5 rounded-lg bg-accent/10 px-3 py-1.5 font-mono text-sm text-accent hover:bg-accent/20">
            <Icon name="phone" class="h-3.5 w-3.5 shrink-0" />
            {n}
          </a>
        </li>
      ))}
    </ul>
  )}

  {(hasSms || hasChat || hasEmail) && (
    <div class="mb-3 flex flex-wrap gap-1.5">
      {hasSms && <span class="chip border-border/60 bg-bg/60 text-fg-muted text-[10px]"><Icon name="sms" class="h-3 w-3" /> SMS</span>}
      {hasChat && <a href={hotline.chat_url!} target="_blank" rel="noopener" class="chip border-accent/30 bg-accent/5 text-accent text-[10px] hover:bg-accent/15"><Icon name="chat" class="h-3 w-3" /> Online chat</a>}
      {hasEmail && <a href={`mailto:${hotline.email}`} class="chip border-border/60 bg-bg/60 text-fg-muted text-[10px] hover:text-fg"><Icon name="email" class="h-3 w-3" /> Email</a>}
    </div>
  )}

  <dl class="grid grid-cols-1 gap-1 text-xs text-fg-muted sm:grid-cols-2">
    {hotline.hours && (<><dt class="text-fg-muted/70">Hours</dt><dd class="text-fg">{hotline.hours}</dd></>)}
    {hotline.cost && hotline.cost !== 'unknown' && (<><dt class="text-fg-muted/70">Cost</dt><dd class="text-fg capitalize">{hotline.cost.replace('_', ' ')}</dd></>)}
    {hotline.languages.length > 0 && (<><dt class="text-fg-muted/70">Languages</dt><dd class="text-fg">{hotline.languages.join(', ')}</dd></>)}
    {hotline.target && (<><dt class="text-fg-muted/70">For</dt><dd class="text-fg">{hotline.target}</dd></>)}
    {serviceArea && (<><dt class="text-fg-muted/70">Service area</dt><dd class="text-fg">{serviceArea}</dd></>)}
    {showCountry && country && (<><dt class="text-fg-muted/70">Country</dt><dd class="text-fg">{country}</dd></>)}
  </dl>

  {freshness.label && (
    <p class={`mt-2 inline-flex items-center gap-1 text-[10px] ${freshnessColour}`} title="When this hotline was last confirmed against an authoritative source">
      <Icon name={freshness.level === 'stale' ? 'alert' : 'shield'} class="h-3 w-3" />
      {freshness.label}
    </p>
  )}

  {(hotline.verification_status === 'legacy_unverified' || hotline.verification_status === 'disputed') && (
    <p class="mt-2 text-[10px] italic text-fg-muted/70">
      {hotline.verification_status === 'disputed' ? 'Conflicting data found — verify before calling.' : 'Unverified — please confirm via official website before relying on this number.'}
    </p>
  )}

  {(hotline.website || linkedSources.length > 0 || reportIssueUrl) && (
    <div class="mt-3 flex flex-wrap gap-2 border-t border-border/60 pt-3 text-xs">
      {hotline.website && <a class="inline-flex items-center gap-1 text-accent hover:underline" href={hotline.website} target="_blank" rel="noopener">Official site <Icon name="external" class="h-3 w-3" /></a>}
      {!hotline.website && linkedSources.map((src) => <a class="inline-flex max-w-[18rem] items-center gap-1 truncate text-fg-muted underline hover:text-accent" href={src} target="_blank" rel="noopener" title={src}>Source <Icon name="external" class="h-3 w-3" /></a>)}
      <a class="inline-flex items-center gap-1 text-fg-muted hover:text-accent hover:underline" href={reportIssueUrl} target="_blank" rel="noopener" title="Report a wrong number, changed hours, closure, or service-area problem. Do not include personal crisis details.">Report a problem <Icon name="external" class="h-3 w-3" /></a>
    </div>
  )}

  {hotline.notes && <p class="mt-3 text-xs leading-relaxed text-fg-muted">{hotline.notes}</p>}
</article>
