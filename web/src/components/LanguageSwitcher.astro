---
import { localeOptions } from '../lib/i18n';

const options = localeOptions();
---

<label class="inline-flex items-center gap-2 rounded-full border border-border/70 bg-bg-elev/70 px-3 py-2 text-sm text-fg-muted">
  <span class="text-xs font-semibold uppercase tracking-[0.18em]" data-i18n="common.language">Language</span>
  <select id="locale-switcher" class="min-w-[8.5rem] bg-transparent text-sm text-fg focus:outline-none" data-i18n-aria-label="header.languageSwitcher" aria-label="Switch language">
    {
      options.map((option) => (
        <option value={option.value}>{option.label}</option>
      ))
    }
  </select>
</label>

<script>
  const select = document.getElementById('locale-switcher') as HTMLSelectElement | null;

  const syncLocale = () => {
    if (!select) return;
    select.value = document.documentElement.lang || 'en';
  };

  select?.addEventListener('change', () => {
    const locale = select.value;
    window.dispatchEvent(new CustomEvent('weh:set-locale', { detail: locale }));
  });

  window.addEventListener('weh:locale-changed', syncLocale);
  syncLocale();
</script>
