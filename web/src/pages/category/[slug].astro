---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getByCategory, getCategoriesStats } from '../../lib/data';
import { availableCategoryFilterValues, categoryFilterSummary, SOURCE_CHECKED_STATUSES } from '../../lib/category-filters.js';
import { CATEGORY_META } from '../../lib/types';
import { breadcrumbJsonLd, isCategoryIndexable } from '../../lib/seo';
import { SITE_URL } from '../../lib/site';

export const getStaticPaths = async () => {
  const stats = await getCategoriesStats();
  return stats.categories.map((c) => ({ params: { slug: c.slug } }));
};

const { slug } = Astro.params as { slug: string };

const results = await getByCategory(slug);
const stats = await getCategoriesStats();
const categoryStat = stats.categories.find((entry) => entry.slug === slug);

const meta = CATEGORY_META[slug];

// Sort countries: verified first, then by hotline count
results.sort((a, b) => {
  const aVerified = a.hotlines.filter((h) =>
    ['verified_web', 'verified_authority', 'verified_knowledge'].includes(h.verification_status)
  ).length;
  const bVerified = b.hotlines.filter((h) =>
    ['verified_web', 'verified_authority', 'verified_knowledge'].includes(h.verification_status)
  ).length;
  if (bVerified !== aVerified) return bVerified - aVerified;
  return b.hotlines.length - a.hotlines.length;
});

// Group by region
const byRegion: Map<string, typeof results> = new Map();
for (const entry of results) {
  const region = entry.country.region ?? 'Other';
  const list = byRegion.get(region) ?? [];
  list.push(entry);
  byRegion.set(region, list);
}

// Region display order
const REGION_ORDER = ['Europe', 'Americas', 'Asia', 'Africa', 'Oceania', 'Other'];
const orderedRegions = [
  ...REGION_ORDER.filter((r) => byRegion.has(r)),
  ...[...byRegion.keys()].filter((r) => !REGION_ORDER.includes(r)).sort(),
];

function flagEmoji(cc: string): string {
  if (!/^[A-Z]{2}$/.test(cc)) return '🏳️';
  const A = 127397;
  return String.fromCodePoint(cc.charCodeAt(0) + A, cc.charCodeAt(1) + A);
}

function availableChannels(hotlines: typeof results[number]['hotlines']): string[] {
  const channels: string[] = [];
  if (hotlines.some((h) => h.voice_numbers.length > 0 || h.short_codes.length > 0)) channels.push('Phone');
  if (hotlines.some((h) => h.sms_numbers.length > 0 || h.text_numbers.length > 0)) channels.push('SMS/text');
  if (hotlines.some((h) => Boolean(h.chat_url))) channels.push('Online chat');
  if (hotlines.some((h) => Boolean(h.email))) channels.push('Email');
  return channels;
}

const totalHotlines = results.reduce((sum, e) => sum + e.hotlines.length, 0);
const totalVerified = results.reduce(
  (sum, e) =>
    sum +
    e.hotlines.filter((h) =>
      SOURCE_CHECKED_STATUSES.has(h.verification_status)
    ).length,
  0
);
const filterSummaries = results.map(({ country, hotlines }) => categoryFilterSummary(country.alpha2.toLowerCase(), hotlines));
const availableFilterValues = availableCategoryFilterValues(filterSummaries);
const showEvidenceFilters = availableFilterValues.evidence.length > 0;
const showChannelFilters = availableFilterValues.channels.length > 0;

const evidenceLabels: Record<string, string> = {
  source_checked: 'Source checked',
  cross_referenced: 'Cross-referenced',
  other_evidence: 'Other evidence status',
};
const channelLabels: Record<string, string> = {
  phone: 'Callable phone',
  text: 'Messageable SMS/text',
  chat: 'Online chat',
  website: 'Website',
};
interface FilterRecord {
  evidence: string;
  channels: string[];
}
interface FilterSummary {
  id: string;
  records: FilterRecord[];
}

const label = meta?.label ?? slug.replace(/_/g, ' ');
const icon = meta?.icon ?? '🌐';
const description = meta?.description ?? '';

const hotlineWord = totalHotlines === 1 ? 'hotline' : 'hotlines';
const countryWord = results.length === 1 ? 'country' : 'countries';
const pageTitle = `${label} hotlines by country`;
const pageDescription = `${description}. Browse ${totalHotlines} ${hotlineWord} in ${results.length} ${countryWord}.`;
const indexable = categoryStat ? isCategoryIndexable(categoryStat) : false;
const breadcrumbs = breadcrumbJsonLd([{ name: 'Home', path: '/' }, { name: 'Categories', path: '/categories' }, { name: label, path: `/category/${slug}` }], Astro.site ?? SITE_URL);
---

<Base title={pageTitle} description={pageDescription} robots={indexable ? 'index,follow' : 'noindex,follow'} jsonLd={breadcrumbs}>
  <!-- Breadcrumb -->
  <nav class="mb-6 flex items-center gap-2 text-xs text-fg-muted" aria-label="Breadcrumb">
    <a href="/" class="hover:text-fg">Home</a>
    <span aria-hidden="true">›</span>
    <a href="/categories" class="hover:text-fg">Categories</a>
    <span aria-hidden="true">›</span>
    <span class="text-fg">{label}</span>
  </nav>

  <!-- Category header -->
  <div class="mb-8">
    <div class="flex items-center gap-4">
      <span class="text-5xl" aria-hidden="true">{icon}</span>
      <div>
        <h1 class="text-4xl font-semibold text-fg sm:text-5xl">{label} hotlines by country</h1>
        {description && <p class="mt-1 text-base text-fg-muted">{description}</p>}
      </div>
    </div>

    <!-- Stats row -->
    <div class="mt-6 flex flex-wrap gap-4">
      <div class="card flex flex-col p-4 text-center">
        <span class="text-3xl font-semibold text-fg">{totalHotlines}</span>
        <span class="text-xs text-fg-muted">{hotlineWord}</span>
      </div>
      <div class="card flex flex-col p-4 text-center">
        <span class="text-3xl font-semibold text-fg">{results.length}</span>
        <span class="text-xs text-fg-muted">{countryWord}</span>
      </div>
      <div class="card flex flex-col p-4 text-center" aria-label={`${totalVerified} source checked`}>
        <span class="text-3xl font-semibold text-success">{totalVerified}</span>
        <span class="text-xs text-fg-muted">source checked</span>
      </div>
      {totalVerified < totalHotlines && (
        <div class="card flex flex-col p-4 text-center" aria-label={`${totalHotlines - totalVerified} not source checked`}>
          <span class="text-3xl font-semibold text-fg-muted">{totalHotlines - totalVerified}</span>
          <span class="text-xs text-fg-muted">not source checked</span>
        </div>
      )}
    </div>
  </div>

  <p class="mb-6 max-w-3xl text-sm text-fg-muted">
    Category pages summarize availability by country. Detailed records and source status are on each country page.
  </p>

  <!-- Verification note if many unverified -->
  {totalVerified === 0 && (
    <div class="mb-6 rounded-xl border border-accent/30 bg-accent/5 p-4 text-sm">
      <span class="mr-1" aria-hidden="true">⚠️</span>
      <strong class="text-fg">No records in this category have a source-checked status.</strong>
      <span class="text-fg-muted"> Verification statuses and source evidence vary by listing. Review each detailed record and double-check contact details with the provider or responsible authority when possible.</span>
    </div>
  )}

  {(showEvidenceFilters || showChannelFilters || orderedRegions.length > 1) && (
    <aside class="mb-8 rounded-2xl border border-border bg-bg-elev/40 p-5" aria-labelledby="category-filter-heading" data-category-filters hidden>
      <h2 id="category-filter-heading" class="text-lg font-semibold text-fg">Narrow these country summaries</h2>
      <p class="mt-2 max-w-4xl text-sm text-fg-muted">
        Filters describe indexed evidence and usable contact fields only. They do not establish suitability, eligibility, whether a service will answer, or real-time availability. A weaker evidence status does not mean a service is unsafe.
      </p>

      {showEvidenceFilters && (
        <fieldset class="mt-4">
          <legend class="text-sm font-semibold text-fg">Evidence status</legend>
          <div class="mt-2 flex flex-wrap gap-3">
            {availableFilterValues.evidence.map((value) => (
              <label class="chip cursor-pointer border-border bg-bg text-sm text-fg hover:border-accent/50">
                <input type="checkbox" value={value} data-filter-evidence class="accent-accent" />
                {evidenceLabels[value]}
              </label>
            ))}
          </div>
        </fieldset>
      )}

      {showChannelFilters && (
        <fieldset class="mt-4">
          <legend class="text-sm font-semibold text-fg">Usable contact channel</legend>
          <div class="mt-2 flex flex-wrap gap-3">
            {availableFilterValues.channels.map((value) => (
              <label class="chip cursor-pointer border-border bg-bg text-sm text-fg hover:border-accent/50">
                <input type="checkbox" value={value} data-filter-channel class="accent-accent" />
                {channelLabels[value]}
              </label>
            ))}
          </div>
        </fieldset>
      )}

      {orderedRegions.length > 1 && (
        <div class="mt-4">
          <p class="text-sm font-semibold text-fg">Region</p>
          <div class="mt-2 flex flex-wrap gap-2" id="region-filter" role="group" aria-label="Filter by region">
        <button
          class="chip region-tab border-fg bg-fg text-bg"
          data-region="all"
          aria-pressed="true"
        >
          All regions
        </button>
        {orderedRegions.map((region) => (
          <button
            class="chip region-tab hover:border-accent/40 hover:text-fg"
            data-region={region}
            aria-pressed="false"
          >
            {region} ({byRegion.get(region)?.length ?? 0})
          </button>
        ))}
          </div>
        </div>
      )}

      <div class="mt-4 flex flex-wrap items-center gap-3 border-t border-border pt-4">
        <p id="category-filter-status" class="text-sm text-fg-muted" role="status" aria-live="polite" aria-atomic="true">
          Showing all {results.length} country {results.length === 1 ? 'summary' : 'summaries'}.
        </p>
        <button id="category-filter-reset" type="button" class="btn-ghost hidden text-sm">Reset filters</button>
      </div>
    </aside>
  )}

  <!-- Countries grouped by region -->
  <div class="space-y-12" id="regions-container">
    {orderedRegions.map((region) => {
      const entries = byRegion.get(region) ?? [];
      return (
        <section data-region-section={region}>
          <h2 class="mb-4 text-xs font-semibold uppercase tracking-widest text-fg-muted">
            {region} <span class="font-normal normal-case">({entries.length} {entries.length === 1 ? 'country' : 'countries'})</span>
          </h2>
          <div class="space-y-6">
            {entries.map(({ country, hotlines }) => {
              const flag = flagEmoji(country.alpha2);
              const sourceCheckedInCountry = hotlines.filter((h) => SOURCE_CHECKED_STATUSES.has(h.verification_status)).length;
              const summary = categoryFilterSummary(country.alpha2.toLowerCase(), hotlines) as FilterSummary;
              const channels = availableChannels(hotlines);
              return (
                <article class="card p-5" data-category-country-summary data-country-code={country.alpha2.toLowerCase()} data-record-count={hotlines.length} data-source-checked-count={sourceCheckedInCountry} data-channels={channels.join('|')} data-filter-records={JSON.stringify(summary.records.map(({ evidence, channels }) => ({ evidence, channels })))}>
                  <div class="flex items-start gap-3">
                    <span class="text-2xl" aria-hidden="true">{flag}</span>
                    <div class="min-w-0 flex-1">
                      <h3 class="font-semibold text-fg">{country.country}</h3>
                      <p class="mt-1 text-xs text-fg-muted">{hotlines.length} {hotlines.length === 1 ? 'record' : 'records'} · {sourceCheckedInCountry} source checked</p>
                      <p class="mt-2 text-xs text-fg-muted"><span class="font-medium text-fg">Available channels:</span> {channels.length > 0 ? channels.join(', ') : 'None listed'}</p>
                      <a href={`/country/${country.alpha2.toLowerCase()}#category-${slug}`} class="mt-4 inline-flex items-center gap-1 font-semibold text-fg underline decoration-accent underline-offset-4 hover:text-accent">
                        View {label.toLowerCase()} records in {country.country} <span aria-hidden="true">→</span>
                      </a>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      );
    })}
  </div>

  <div id="category-filter-empty" class="hidden rounded-2xl border border-border bg-bg-elev/40 p-8 text-center">
    <h2 class="text-xl font-semibold text-fg">No country summaries match these filters</h2>
    <p class="mt-2 text-sm text-fg-muted">Try another evidence status or contact channel, or show every country summary again.</p>
    <button type="button" class="btn-primary mt-4" data-category-filter-reset>Show all summaries</button>
  </div>

  {results.length === 0 && (
    <div class="rounded-2xl border border-border bg-bg-elev/40 p-12 text-center">
      <span class="mx-auto inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-accent/12 text-accent" aria-hidden="true"><Icon name="dataset" class="h-5 w-5" /></span>
      <h2 class="mt-4 text-2xl font-semibold text-fg">No data yet for this category</h2>
      <p class="mt-2 text-fg-muted">
        We're working on adding hotlines for this category. Contributions welcome!
      </p>
    </div>
  )}

  <!-- Footer links -->
  <div class="mt-12 border-t border-border pt-6 text-xs text-fg-muted">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <a href="/categories" class="text-accent hover:underline">← All categories</a>
        <span class="mx-2">·</span>
        <a href="/data" class="text-accent hover:underline">Download data</a>
        <span class="mx-2">·</span>
        <a href="/about" class="text-accent hover:underline">Methodology</a>
      </div>
    </div>
  </div>
</Base>

<script>
  import { filterCategorySummaries } from '../../lib/category-filters.js';

  const filters = document.querySelector<HTMLElement>('[data-category-filters]');
  const regionFilter = document.getElementById('region-filter');
  const container = document.getElementById('regions-container');
  const status = document.getElementById('category-filter-status');
  const empty = document.getElementById('category-filter-empty');
  const reset = document.getElementById('category-filter-reset');

  if (filters && container && status && empty && reset) {
    const cards = [...container.querySelectorAll<HTMLElement>('[data-category-country-summary]')];
    let activeRegion = 'all';

    const selected = (selector: string) => [...filters.querySelectorAll<HTMLInputElement>(`${selector}:checked`)].map((input) => input.value);
    const summaries = cards.map((card, index) => ({
      id: String(index),
      records: JSON.parse(card.dataset.filterRecords ?? '[]'),
    }));

    const applyFilters = () => {
      const evidence = selected('[data-filter-evidence]');
      const channels = selected('[data-filter-channel]');
      const matchingIds = new Set(filterCategorySummaries(summaries, { evidence, channels }).map((summary: { id: string }) => summary.id));
      let visibleCount = 0;

      cards.forEach((card, index) => {
        const regionSection = card.closest<HTMLElement>('[data-region-section]');
        const regionMatches = activeRegion === 'all' || regionSection?.dataset.regionSection === activeRegion;
        const visible = regionMatches && matchingIds.has(String(index));
        card.hidden = !visible;
        if (visible) visibleCount += 1;
      });

      for (const section of container.querySelectorAll<HTMLElement>('[data-region-section]')) {
        section.hidden = !section.querySelector('[data-category-country-summary]:not([hidden])');
      }

      const narrowed = evidence.length > 0 || channels.length > 0 || activeRegion !== 'all';
      status.textContent = narrowed
        ? `Showing ${visibleCount} of ${cards.length} country summaries.`
        : `Showing all ${cards.length} country summaries.`;
      reset.classList.toggle('hidden', !narrowed || visibleCount === 0);
      container.classList.toggle('hidden', visibleCount === 0);
      empty.classList.toggle('hidden', visibleCount !== 0);
    };

    const resetFilters = () => {
      for (const input of filters.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')) input.checked = false;
      activeRegion = 'all';
      for (const button of filters.querySelectorAll<HTMLElement>('.region-tab')) {
        const active = button.dataset.region === 'all';
        button.setAttribute('aria-pressed', String(active));
        button.classList.toggle('border-fg', active);
        button.classList.toggle('bg-fg', active);
        button.classList.toggle('text-bg', active);
      }
      applyFilters();
    };

    filters.addEventListener('change', applyFilters);
    reset.addEventListener('click', resetFilters);
    empty.querySelector('[data-category-filter-reset]')?.addEventListener('click', resetFilters);

    regionFilter?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('[data-region]') as HTMLButtonElement | null;
      if (!btn) return;
      activeRegion = btn.dataset.region ?? 'all';

      for (const b of regionFilter.querySelectorAll('.region-tab')) {
        const isActive = (b as HTMLElement).dataset.region === activeRegion;
        b.setAttribute('aria-pressed', String(isActive));
        b.classList.toggle('border-fg', isActive);
        b.classList.toggle('bg-fg', isActive);
        b.classList.toggle('text-bg', isActive);
      }
      applyFilters();
    });

    filters.hidden = false;
  }
</script>
