---
import Base from '../../layouts/Base.astro';
import HotlineCard from '../../components/HotlineCard.astro';
import Icon from '../../components/Icon.astro';
import { getManifest, getCountry, getPrioritizedHelp, getFreshnessInfo } from '../../lib/data';
import { CATEGORY_META } from '../../lib/types';
import type { Hotline, HotlineCategory } from '../../lib/types';
import { breadcrumbJsonLd } from '../../lib/seo';
import { SITE_URL } from '../../lib/site';
import { phoneContacts } from '../../lib/contact';
import { generalEmergencyContact } from '../../lib/general-emergency.mjs';

export const getStaticPaths = async () => {
  const manifest = await getManifest();
  return manifest.countries.map((c) => ({
    params: { code: c.alpha2.toLowerCase() },
  }));
};

const { code } = Astro.params as { code: string };
const country = await getCountry(code.toUpperCase());

// Should never happen since paths come from manifest, but guard for type safety
if (!country) {
  return Astro.redirect('/404');
}

const SOURCE_CHECKED_STATUSES = new Set(['verified_web', 'verified_authority', 'verified_knowledge']);
const sourceCheckedHotlines = country.hotlines.filter((h) => SOURCE_CHECKED_STATUSES.has(h.verification_status));
const notSourceCheckedCount = country.hotlines.length - sourceCheckedHotlines.length;

// Mechanically prioritized crisis/support listing
const bestHelp = getPrioritizedHelp(country.hotlines);
const bestHelpIsSourceChecked = bestHelp ? SOURCE_CHECKED_STATUSES.has(bestHelp.verification_status) : false;
const bestHelpStatus = bestHelpIsSourceChecked
  ? 'source checked'
  : bestHelp?.verification_status === 'cross_referenced'
    ? 'cross-referenced'
    : 'not source checked';

// Group hotlines by category for the tabbed view
const hotlinesByCategory: Map<HotlineCategory, Hotline[]> = new Map();
for (const h of country.hotlines) {
  const list = hotlinesByCategory.get(h.category) ?? [];
  list.push(h);
  hotlinesByCategory.set(h.category, list);
}

// Ordered categories: crisis-priority first, then alphabetical
const PRIORITY_ORDER: HotlineCategory[] = [
  'suicide_crisis', 'mental_health', 'domestic_violence', 'sexual_violence',
  'child_protection', 'lgbtqia', 'substance_use', 'veterans',
  'general_support', 'emergency',
];
const allCats = [...hotlinesByCategory.keys()];
const orderedCats = [
  ...PRIORITY_ORDER.filter((c) => hotlinesByCategory.has(c)),
  ...allCats.filter((c) => !PRIORITY_ORDER.includes(c)).sort(),
];

function flagEmoji(cc: string): string {
  if (!/^[A-Z]{2}$/.test(cc)) return '🏳️';
  const A = 127397;
  return String.fromCodePoint(cc.charCodeAt(0) + A, cc.charCodeAt(1) + A);
}

const flag = flagEmoji(country.alpha2);
const emergency = country.general_emergency ?? [];
// Top-level emergency values are actionable only when the canonical display is
// already one complete, unambiguous numeric dial string.
const emergencyContacts = emergency.map(generalEmergencyContact);

// Freshness info for best help line
const bestHelpFreshness = bestHelp ? getFreshnessInfo(bestHelp) : null;
const bestHelpPhones = bestHelp ? phoneContacts(bestHelp.voice_numbers, bestHelp.short_codes).slice(0, 2) : [];

const title = `${country.country}: emergency numbers and crisis hotlines`;
const description = `Find emergency numbers and crisis hotlines in ${country.country}. ${country.hotlines.length} ${country.hotlines.length === 1 ? 'hotline' : 'hotlines'} listed; ${sourceCheckedHotlines.length} source checked.`;
const breadcrumbs = breadcrumbJsonLd([{ name: 'Home', path: '/' }, { name: 'Countries', path: '/countries' }, { name: country.country, path: `/country/${country.alpha2.toLowerCase()}` }], Astro.site ?? SITE_URL);
---

<Base title={title} description={description} robots={country.hotlines.length === 0 ? 'noindex,follow' : 'index,follow'} jsonLd={breadcrumbs}>
  <!-- Breadcrumb -->
  <nav class="mb-6 flex items-center gap-2 text-xs text-fg-muted" aria-label="Breadcrumb">
    <a href="/" class="underline hover:text-fg">Home</a>
    <span aria-hidden="true">›</span>
    <a href="/countries" class="underline hover:text-fg">Countries</a>
    <span aria-hidden="true">›</span>
    <span class="text-fg">{country.country}</span>
  </nav>

  <!-- Country header -->
  <div class="mb-8 flex flex-wrap items-start gap-4">
    <span class="text-5xl leading-none" aria-hidden="true">{flag}</span>
    <div class="min-w-0 flex-1">
      <h1 class="text-4xl font-semibold text-fg sm:text-5xl">Emergency numbers and crisis hotlines in {country.country}</h1>
      <p class="mt-3 max-w-3xl text-sm text-fg-muted">This page lists {country.hotlines.length} {country.hotlines.length === 1 ? 'record' : 'records'} for {country.country}. Source information and verification status vary and are shown per record. These statuses do not confirm live availability; verify details locally and with the cited provider or authority when available.</p>
      <p class="mt-1 text-sm text-fg-muted">
        {country.alpha2}
        {country.region && <span> · {country.region}</span>}
        {country.subregion && country.subregion !== country.region && <span> · {country.subregion}</span>}
      </p>
      <div class="mt-2 flex flex-wrap gap-2 text-xs">
        <span class="chip">
          {country.hotlines.length} hotline{country.hotlines.length !== 1 ? 's' : ''}
        </span>
        {sourceCheckedHotlines.length > 0 && (
          <span class="chip border-success bg-bg-elev text-fg">
            {sourceCheckedHotlines.length} source checked
          </span>
        )}
        {notSourceCheckedCount > 0 && sourceCheckedHotlines.length === 0 && (
          <span class="chip border-fg-muted/30 text-fg-muted">
            No source-checked records
          </span>
        )}
      </div>
    </div>
    <div class="flex shrink-0 gap-2">
      <a href={`/map#${country.alpha2}`} class="btn-ghost text-xs"><Icon name="map" class="h-3.5 w-3.5" /> View on map</a>
    </div>
  </div>

  <!-- Emergency numbers — always first, highest visual priority -->
  {emergency.length > 0 && (
    <div data-general-emergency-listing data-country-code={country.alpha2} class="mb-6 rounded-2xl border-2 border-danger bg-bg-elev p-5">
      <div class="flex items-start gap-3">
        <span class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-danger text-bg" aria-hidden="true"><Icon name="alert" class="h-5 w-5" /></span>
        <div>
          <h2 class="font-semibold text-fg">Emergency numbers</h2>
          <p class="mt-1 text-xs text-fg-muted">Police · Fire · Ambulance</p>
          <div class="mt-2 flex flex-wrap gap-2">
            {emergencyContacts.map(({ value, uri }) => (
              uri ? <a
                href={`tel:${uri}`}
                data-phone-contact={uri}
                data-general-emergency-contact={value}
                class="inline-flex items-center gap-1.5 rounded-lg border-2 border-danger bg-danger px-4 py-2 font-mono text-xl font-bold text-bg hover:border-fg hover:bg-fg"
              >{value}</a> : <span
                data-general-emergency-contact={value}
                class="inline-flex items-center gap-1.5 rounded-lg border-2 border-danger bg-danger px-4 py-2 font-mono text-xl font-bold text-bg"
              >{value}</span>
            ))}
          </div>
          {country.notes && (
            <p class="mt-2 text-xs text-fg-muted">{country.notes}</p>
          )}
        </div>
      </div>
    </div>
  )}

  <!-- Prioritized listing box -->
  {bestHelp && (
    <div data-prioritized-listing data-prioritized-record-id={bestHelp.id} data-prioritized-status={bestHelpStatus} class="mb-6 rounded-2xl border border-border bg-bg-elev/40 p-5">
      <div class="mb-3 flex items-center gap-2">
        <span data-prioritized-icon class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-border bg-bg text-fg-muted" aria-hidden="true">
          <Icon name="dataset" class="h-4 w-4" />
        </span>
        <div>
          <h2 class="text-sm font-semibold text-fg">Prioritized listing</h2>
          <p class="text-xs text-fg-muted">Status: {bestHelpStatus}</p>
          {!bestHelpIsSourceChecked && bestHelp.verification_status !== 'cross_referenced' && (
            <p class="text-xs text-fg-muted">Double-check this number before calling — it does not have a source-checked status.</p>
          )}
          <p class="mt-1 max-w-3xl text-xs text-fg-muted">
            Prioritized routing selects the first source-checked or cross-referenced listing in category order: suicide crisis, mental health, domestic violence, sexual violence, child protection, then general support. It then uses the first listing in that category order, or the first dataset listing. This does not determine suitability, eligibility, live availability, or provide medical advice.
          </p>
        </div>
      </div>
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <p class="font-semibold text-fg">{bestHelp.name}</p>
          {bestHelp.organization && bestHelp.organization !== bestHelp.name && (
            <p class="text-xs text-fg-muted">{bestHelp.organization}</p>
          )}
          <p class="mt-0.5 text-xs text-fg-muted capitalize">
            {(CATEGORY_META[bestHelp.category]?.label ?? bestHelp.category).replace(/_/g, ' ')}
            {bestHelp.hours && <span> · {bestHelp.hours}</span>}
          </p>
          {bestHelpFreshness && bestHelpFreshness.label && (
            <p class="mt-1 text-xs text-fg-muted">
              {bestHelpFreshness.label}
            </p>
          )}
        </div>
        <div class="flex flex-wrap gap-2">
          {bestHelpPhones.map(({ value, uri }) => (
            uri ? <a href={`tel:${uri}`} data-phone-contact={uri} class="inline-flex items-center gap-1.5 rounded-lg border border-accent bg-bg-elev px-3 py-2 font-mono text-base font-semibold text-fg hover:bg-accent hover:text-bg">
              <Icon name="phone" class="h-3.5 w-3.5" /> {value}
            </a> : <span data-phone-contact={value} class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-bg-elev px-3 py-2 font-mono text-base text-fg">
              <Icon name="phone" class="h-3.5 w-3.5" /> {value}
            </span>
          ))}
          {bestHelp.chat_url && (
            <a
              href={bestHelp.chat_url}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-1.5 rounded-lg border border-accent bg-bg-elev px-3 py-2 text-sm font-semibold text-fg hover:bg-accent hover:text-bg"
            >
              <Icon name="chat" class="h-3.5 w-3.5" /> Chat
            </a>
          )}
        </div>
      </div>
    </div>
  )}

  {country.hotlines.length === 0 && (
    <div class="mb-6 rounded-2xl border border-border bg-bg-elev/40 p-6 text-center">
      <span class="mx-auto inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-accent/12 text-accent" aria-hidden="true"><Icon name="dataset" class="h-5 w-5" /></span>
      <h2 class="mt-2 font-semibold text-fg">No hotlines listed yet</h2>
      <p class="mt-1 text-sm text-fg-muted">
        We don't have specific hotline data for {country.country} yet.
        This dataset does not currently contain a country-specific listing. Emergency numbers and carrier or SIM access vary; verify the appropriate number locally.
      </p>
    </div>
  )}

  <!-- Traveller guidance -->
  <div class="mb-8 rounded-2xl border border-border bg-bg-elev/30 p-4 text-sm text-fg-muted">
    <span class="mr-2 inline-flex h-8 w-8 items-center justify-center rounded-full bg-accent/10 text-accent" aria-hidden="true"><Icon name="map" class="h-4 w-4" /></span>
    <strong class="text-fg">Traveller note:</strong> Most hotlines listed here require a local {country.country} phone number or SIM card.
    If calling from abroad, you may need to dial your country's international exit code followed by the {country.country} country code,
    and some free-call numbers may not connect internationally. Emergency access varies by carrier and SIM status; verify current local guidance.
  </div>

  <!-- Data quality notice when no records have a source-checked status -->
  {country.hotlines.length > 0 && sourceCheckedHotlines.length === 0 && (
    <div class="mb-6 rounded-xl border border-accent/30 bg-accent/5 p-4 text-sm">
      <span class="mr-1 inline-flex align-middle text-accent" aria-hidden="true"><Icon name="alert" class="h-4 w-4" /></span>
      <strong class="text-accent">No records have a source-checked status.</strong>
      <span class="text-fg-muted"> Evidence and verification statuses vary by record. Review each record and double-check contact details with the provider or responsible authority when possible.</span>
    </div>
  )}

  <!-- Category filter tabs (client-side) -->
  {orderedCats.length > 1 && (
    <div class="mb-6">
      <div class="flex flex-wrap gap-2" id="cat-filter" role="group" aria-label="Filter by category">
        <button
          class="chip cat-tab border-fg bg-fg text-bg"
          data-cat="all"
          aria-pressed="true"
        >
          All ({country.hotlines.length})
        </button>
        {orderedCats.map((cat) => {
          const meta = CATEGORY_META[cat];
          const count = hotlinesByCategory.get(cat)?.length ?? 0;
          return (
            <button
              class="chip cat-tab hover:border-accent/40 hover:text-fg"
              data-cat={cat}
              aria-pressed="false"
            >
              {meta?.icon && <span aria-hidden="true">{meta.icon}</span>}
              {meta?.label ?? cat.replace(/_/g, ' ')} ({count})
            </button>
          );
        })}
      </div>
    </div>
  )}

  <!-- Hotlines grid -->
  {orderedCats.length > 0 && (
    <div class="space-y-8" id="hotlines-container">
      {orderedCats.map((cat) => {
        const hotlines = hotlinesByCategory.get(cat) ?? [];
        const meta = CATEGORY_META[cat];
        // Tailwind scroll-mt-48 (12rem) clears both sticky surfaces plus breathing room.
        return (
          <section id={`category-${cat}`} class="scroll-mt-48" data-section-cat={cat}>
            <h2 class="mb-3 flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-fg-muted">
              {meta?.icon && <span aria-hidden="true">{meta.icon}</span>}
              <a class="underline hover:text-fg" href={`/category/${cat}`}>{meta?.label ?? cat.replace(/_/g, ' ')}</a>
              <span class="text-xs font-normal normal-case">({hotlines.length})</span>
            </h2>
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {hotlines.map((h) => (
                <div data-card-cat={cat}>
                  <HotlineCard hotline={h} country={country.country} showCountry={false} />
                </div>
              ))}
            </div>
          </section>
        );
      })}
    </div>
  )}

  <!-- Data access footer -->
  <div class="mt-12 border-t border-border pt-8 text-xs text-fg-muted">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <p>
          Data for {country.country} · <a href="/about" class="text-accent hover:underline">Methodology</a> ·
          <a href={`/data/countries/${country.alpha2.toLowerCase()}.json`} class="text-accent hover:underline" target="_blank">
            Download {country.alpha2.toLowerCase()}.json ↗
          </a>
        </p>
        <p class="mt-1">
          Found an error? <a href="https://github.com/craigrallen/world-emergency-hotlines/issues" class="text-accent hover:underline" target="_blank" rel="noopener">Open an issue ↗</a>
        </p>
      </div>
      <a href="/data" class="btn-ghost text-xs">All data downloads</a>
    </div>
  </div>
</Base>

<script>
  // Client-side category filter for the tabbed hotline view
  const filterGroup = document.getElementById('cat-filter');
  const container = document.getElementById('hotlines-container');

  if (filterGroup && container) {
    filterGroup.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('[data-cat]') as HTMLButtonElement | null;
      if (!btn) return;
      const cat = btn.dataset.cat;

      // Update button states
      for (const b of filterGroup.querySelectorAll('.cat-tab')) {
        const isActive = (b as HTMLElement).dataset.cat === cat;
        b.setAttribute('aria-pressed', String(isActive));
        b.classList.toggle('border-fg', isActive);
        b.classList.toggle('bg-fg', isActive);
        b.classList.toggle('text-bg', isActive);
      }

      // Show/hide sections
      for (const section of container.querySelectorAll('[data-section-cat]')) {
        const sectionCat = (section as HTMLElement).dataset.sectionCat;
        (section as HTMLElement).hidden = cat !== 'all' && sectionCat !== cat;
      }
    });
  }
</script>
