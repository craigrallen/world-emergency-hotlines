---
import Base from '../../layouts/Base.astro';
---
<Base title="Checkout complete · World Emergency & Hotlines" description="Return page after Stripe hosted checkout." robots="noindex,follow" canonical={false}>
  <article class="mx-auto max-w-3xl">
    <p class="text-sm font-semibold uppercase tracking-wider text-accent">Stripe checkout</p>
    <h1 class="mt-2 text-4xl font-semibold text-fg sm:text-5xl">Checkout complete</h1>
    <p class="mt-4 text-fg-muted">Stripe will email your receipt. Payment and subscription status are confirmed by webhook; reaching this page does not grant access.</p>
    <p class="mt-4 text-fg-muted">Sign in to your <a class="text-accent hover:underline" href="/account">account</a> to manage linked subscriptions. For a purchase without an account, contact the maintainers through the repository for ownership verification.</p>
    <p class="mt-4 text-fg-muted">Crisis information remains free and keyless. <a class="text-accent hover:underline" href="/billing">Back to billing</a>.</p>
  </article>

  <script is:inline>
    (() => {
      try {
        const url = new URL(window.location.href);
        if (url.searchParams.has('session_id')) {
          url.searchParams.delete('session_id');
          history.replaceState(history.state, '', url.pathname + (url.search || '') + url.hash);
        }
      } catch {}
    })();
  </script>
</Base>
