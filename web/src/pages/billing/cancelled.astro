---
import Base from '../../layouts/Base.astro';
---

<Base title="Checkout cancelled · World Emergency & Hotlines" description="Return page when Stripe hosted checkout is abandoned." robots="noindex,follow" canonical={false}>
  <article class="mx-auto max-w-3xl">
    <p class="text-sm font-semibold uppercase tracking-wider text-accent">Stripe checkout</p>
    <h1 class="mt-2 text-4xl font-semibold text-fg sm:text-5xl">Checkout cancelled</h1>
    <p class="mt-4 text-lg text-fg-muted">Nothing was charged and no account was created. Every free surface of this site remains available exactly as before.</p>
    <div class="mt-8 flex flex-wrap gap-4 text-sm">
      <a class="btn-primary" href="/billing">Back to billing</a>
      <a class="btn-ghost" href="/managed-api">Proposed managed API plans</a>
      <a class="btn-ghost" href="/find-help">Find help</a>
    </div>
  </article>
</Base>
