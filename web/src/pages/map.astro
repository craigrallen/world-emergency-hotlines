---
import Base from '../layouts/Base.astro';
---

<Base
  title="World map · Hotlines"
  description="Explore emergency and crisis hotlines on a zoomable, mobile-friendly world map."
  bleed={true}
>
  <div class="relative h-[calc(100dvh-64px)] min-h-[560px] w-full">
    <!-- Map container -->
    <div
      id="hotlines-map"
      class="absolute inset-0 bg-bg"
      role="application"
      aria-label="World map of hotlines"
    ></div>

    <!-- Loading overlay -->
    <div
      id="map-loading"
      class="pointer-events-none absolute inset-0 z-[400] flex items-center justify-center bg-bg/80 text-sm text-fg-muted"
    >
      <div class="rounded-full border border-border bg-bg-elev px-4 py-2">Loading world map…</div>
    </div>

    <!-- Error banner (hidden unless something fails) -->
    <div
      id="map-error"
      class="pointer-events-auto absolute left-3 right-3 top-3 z-[500] hidden rounded-xl border border-danger/60 bg-danger/15 p-3 text-sm text-fg"
      role="alert"
    ></div>

    <!-- Legend -->
    <div
      class="pointer-events-auto absolute left-3 bottom-20 z-[450] flex flex-col gap-1.5 rounded-xl border border-border bg-bg-elev/85 p-3 text-xs text-fg shadow-xl backdrop-blur sm:left-4 sm:bottom-24"
      aria-label="Legend"
    >
      <p class="mb-1 text-[11px] uppercase tracking-wider text-fg-muted">Data coverage</p>
      <div class="flex items-center gap-2"><span class="inline-block h-3 w-3 rounded-sm" style="background:#f0b86e"></span> Verified hotlines</div>
      <div class="flex items-center gap-2"><span class="inline-block h-3 w-3 rounded-sm" style="background:#7a6a9e"></span> Legacy / unverified</div>
      <div class="flex items-center gap-2"><span class="inline-block h-3 w-3 rounded-sm" style="background:#2a3252"></span> No data yet</div>
    </div>

    <!-- Country panel (slide-in drawer) -->
    <aside
      id="country-panel"
      class="pointer-events-auto absolute right-0 top-0 z-[460] hidden h-full w-full max-w-md translate-x-full overflow-y-auto border-l border-border bg-bg/95 p-5 backdrop-blur transition-transform duration-300 ease-out sm:w-[420px]"
      aria-live="polite"
    >
      <button
        id="country-panel-close"
        type="button"
        class="sticky top-0 ml-auto flex items-center gap-1 rounded-full bg-bg-elev px-3 py-1.5 text-xs text-fg-muted hover:text-fg"
        aria-label="Close country panel"
      >Close ✕</button>
      <div id="country-panel-body" class="mt-4"></div>
    </aside>
  </div>

  <!-- Leaflet CSS (CDN, allowed by CSP style-src) -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
  <!-- Leaflet JS (CDN, allowed by CSP script-src). Loads synchronously before our inline script. -->
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>

  <script is:inline>
    (function () {
      const errBox = document.getElementById('map-error');
      const loadingBox = document.getElementById('map-loading');
      const panel = document.getElementById('country-panel');
      const panelBody = document.getElementById('country-panel-body');
      const panelClose = document.getElementById('country-panel-close');

      function showError(msg) {
        console.error('[map]', msg);
        if (!errBox) return;
        errBox.textContent = msg;
        errBox.classList.remove('hidden');
        if (loadingBox) loadingBox.style.display = 'none';
      }

      window.addEventListener('error', function (ev) {
        if (ev.error) showError('Script error: ' + (ev.error.message || String(ev.error)));
      });
      window.addEventListener('unhandledrejection', function (ev) {
        const r = ev.reason;
        showError('Unhandled error: ' + ((r && r.message) || r || 'unknown'));
      });

      if (typeof L === 'undefined') {
        showError('Leaflet failed to load. Check your network or try again.');
        return;
      }

      const container = document.getElementById('hotlines-map');
      if (!container) {
        showError('Map container missing — please reload.');
        return;
      }

      let map;
      try {
        map = L.map(container, {
          worldCopyJump: true,
          minZoom: 2,
          maxZoom: 10,
          attributionControl: true,
          zoomControl: true,
        }).setView([20, 15], 2);
      } catch (err) {
        showError("Couldn't initialise map: " + (err && err.message ? err.message : err));
        return;
      }

      // Dark raster basemap from CARTO (free, no key needed)
      L.tileLayer(
        'https://{s}.basemaps.cartocdn.com/dark_nolabels/{z}/{x}/{y}{r}.png',
        {
          subdomains: 'abcd',
          maxZoom: 19,
          attribution:
            '© <a href="https://www.openstreetmap.org/copyright">OSM</a> · © <a href="https://carto.com/attributions">CARTO</a>',
        }
      ).addTo(map);

      // Hide loading overlay once the first tile loads (safe upper-bound fallback after 4s)
      let hidden = false;
      function hideLoading() {
        if (hidden) return;
        hidden = true;
        if (loadingBox) loadingBox.style.display = 'none';
      }
      map.whenReady(hideLoading);
      setTimeout(hideLoading, 4000);

      // Load country manifest and plot markers
      fetch('/data/manifest.json')
        .then(function (r) {
          if (!r.ok) throw new Error('manifest ' + r.status);
          return r.json();
        })
        .then(function (manifest) {
          manifest.countries.forEach(function (c) {
            if (!c.centroid) return;
            const verified = c.verified_count > 0;
            const color = c.hotline_count === 0 ? '#2a3252' : verified ? '#f0b86e' : '#7a6a9e';
            const radius = 4 + Math.sqrt(c.hotline_count || 1) * 1.2;
            const marker = L.circleMarker([c.centroid.lat, c.centroid.lng], {
              radius: radius,
              color: '#0b1020',
              weight: 1.5,
              fillColor: color,
              fillOpacity: 0.9,
            }).addTo(map);
            marker.bindTooltip(
              c.name + ' · ' + c.hotline_count + ' hotline' + (c.hotline_count === 1 ? '' : 's'),
              { direction: 'top' }
            );
            marker.on('click', function () {
              openCountry(c.alpha2);
            });
          });
        })
        .catch(function (err) {
          console.warn('[map] manifest unavailable:', err);
        });

      // --- Country panel ---
      function escape(s) {
        return String(s).replace(/[&<>"']/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
      }
      function flagEmoji(cc) {
        if (!/^[A-Z]{2}$/.test(cc)) return '🏳️';
        const A = 127397;
        return String.fromCodePoint(cc.charCodeAt(0) + A, cc.charCodeAt(1) + A);
      }
      function cleanNumber(raw) {
        let n = String(raw).trim();
        while ((n.split('(').length - 1) > (n.split(')').length - 1)) {
          const i = n.lastIndexOf(' (');
          if (i <= 0) break;
          n = n.slice(0, i).trim();
        }
        while ((n.split(')').length - 1) > (n.split('(').length - 1) && n.endsWith(')')) {
          n = n.slice(0, -1).trim();
        }
        if (/^\d+\)/.test(n) && n.indexOf('(') === -1) n = '(' + n;
        return n;
      }

      function renderCountry(c) {
        const flag = flagEmoji(c.alpha2);
        const emergency = (c.general_emergency || []).join(' · ') || '—';
        const items = (c.hotlines || [])
          .map(function (h) {
            const nums = (h.voice_numbers || []).concat(h.short_codes || [])
              .map(cleanNumber)
              .filter(function (n) { return n.length > 0; });
            const numHtml = nums
              .map(function (n) {
                return '<a href="tel:' + escape(n.replace(/\s+/g, '')) + '" class="mr-2 inline-block rounded-md bg-accent/10 px-2 py-1 font-mono text-xs text-accent hover:bg-accent/20">' + escape(n) + '</a>';
              })
              .join('');
            return (
              '<article class="card p-4">' +
                '<header class="mb-2 flex items-start justify-between gap-2">' +
                  '<h3 class="text-sm font-semibold text-fg">' + escape(h.name) + '</h3>' +
                  '<span class="chip text-[10px]">' + escape((h.category || '').replace(/_/g, ' ')) + '</span>' +
                '</header>' +
                (numHtml ? '<div class="mb-2">' + numHtml + '</div>' : '') +
                (h.hours ? '<p class="text-xs text-fg-muted">' + escape(h.hours) + '</p>' : '') +
                (h.website ? '<a class="mt-1 inline-block text-xs text-accent hover:underline" href="' + escape(h.website) + '" target="_blank" rel="noopener">Website ↗</a>' : '') +
              '</article>'
            );
          })
          .join('');

        return (
          '<div class="mb-4 flex items-center gap-3">' +
            '<span class="text-3xl" aria-hidden="true">' + flag + '</span>' +
            '<div>' +
              '<h2 class="font-display text-2xl text-fg">' + escape(c.country) + '</h2>' +
              '<p class="text-xs text-fg-muted">' + c.alpha2 + ' · ' + escape(c.region || '') + '</p>' +
            '</div>' +
          '</div>' +
          '<div class="mb-5 rounded-xl border border-danger/40 bg-danger/10 p-3 text-sm text-fg">' +
            '<p class="font-semibold text-danger">Immediate emergency</p>' +
            '<p class="font-mono text-lg text-fg">' + escape(emergency) + '</p>' +
            (c.notes ? '<p class="mt-1 text-xs text-fg-muted">' + escape(c.notes) + '</p>' : '') +
          '</div>' +
          '<h3 class="mb-3 text-xs uppercase tracking-wider text-fg-muted">' + ((c.hotlines || []).length) + ' hotlines</h3>' +
          '<div class="space-y-3">' + (items || '<p class="text-sm text-fg-muted">No hotlines listed yet.</p>') + '</div>' +
          '<p class="mt-4 text-center"><a href="/country/' + c.alpha2.toLowerCase() + '" class="text-sm text-accent hover:underline">Full page for ' + escape(c.country) + ' →</a></p>'
        );
      }

      function openCountry(alpha2) {
        if (!panel || !panelBody) return;
        panelBody.innerHTML = '<p class="text-sm text-fg-muted">Loading ' + alpha2 + '…</p>';
        panel.classList.remove('hidden');
        requestAnimationFrame(function () {
          panel.classList.remove('translate-x-full');
        });
        fetch('/data/countries/' + alpha2 + '.json')
          .then(function (r) {
            if (!r.ok) throw new Error(alpha2 + ' ' + r.status);
            return r.json();
          })
          .then(function (data) {
            panelBody.innerHTML = renderCountry(data);
          })
          .catch(function (err) {
            panelBody.innerHTML = '<p class="text-sm text-danger">Couldn\'t load ' + alpha2 + '. ' + String(err) + '</p>';
          });
      }

      function closePanel() {
        if (!panel) return;
        panel.classList.add('translate-x-full');
        setTimeout(function () { panel.classList.add('hidden'); }, 300);
      }

      if (panelClose) panelClose.addEventListener('click', closePanel);
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closePanel();
      });
    })();
  </script>

  <!-- Harmonize Leaflet controls with dark theme -->
  <style>
    .leaflet-container {
      background: rgb(var(--bg));
      font-family: inherit;
    }
    .leaflet-control-zoom a,
    .leaflet-control-attribution {
      background: rgb(var(--bg-elev) / 0.9) !important;
      color: rgb(var(--fg)) !important;
      border-color: rgb(var(--border)) !important;
      backdrop-filter: blur(8px);
    }
    .leaflet-control-zoom a:hover { background: rgb(var(--bg-elev)) !important; }
    .leaflet-control-attribution a { color: rgb(var(--fg-muted)) !important; }
    .leaflet-tooltip {
      background: rgb(var(--bg-elev));
      color: rgb(var(--fg));
      border: 1px solid rgb(var(--border));
      border-radius: 0.5rem;
      padding: 0.35rem 0.6rem;
      font-size: 12px;
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.35);
    }
    .leaflet-tooltip-top:before { border-top-color: rgb(var(--bg-elev)); }
  </style>
</Base>
