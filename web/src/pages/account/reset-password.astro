---
import Base from '../../layouts/Base.astro';
import { ACCOUNTS_ENABLED, ACCOUNTS_MODE } from '../../lib/accounts';

const disabled = !ACCOUNTS_ENABLED;
const field = 'mt-1 w-full rounded-lg border border-border bg-bg px-3 py-2 text-fg disabled:cursor-not-allowed disabled:opacity-50';
---

<Base title="Reset your password · World Emergency & Hotlines" description="Choose a new password for a World Hotlines account from the link in the reset email." robots="noindex,follow" canonical={false}>
  <article class="mx-auto max-w-3xl" data-reset-root data-accounts-mode={ACCOUNTS_MODE} data-account-view="loading">
    <p class="text-sm font-semibold uppercase tracking-wider text-accent">Account</p>
    <h1 class="mt-2 text-4xl font-semibold text-fg sm:text-5xl">Choose a new password</h1>
    <p class="mt-4 text-lg text-fg-muted">The reset link in your email is valid for one hour and can be used once.</p>
    <p class="mt-6 rounded-xl border border-border bg-bg-elev p-4 text-sm text-fg" data-account-flash hidden aria-live="polite"></p>
    <p class="mt-8 text-sm text-fg-muted" data-account-view="loading" hidden={disabled} aria-live="polite">Checking your reset link…</p>
    <aside class="mt-8 rounded-xl border border-amber-400/60 bg-amber-400/10 p-5" data-account-view="disabled" hidden={!disabled}>
      <h2 class="text-xl font-semibold text-fg">Accounts are not enabled</h2>
      <p class="mt-2 text-sm text-fg-muted">The account service is switched off on this site, so no password can be reset yet.</p>
    </aside>
    <form class="mt-8 space-y-3 rounded-xl border border-border bg-bg-elev p-5" data-account-view="form" data-reset-form hidden>
      <label class="block text-sm text-fg-muted">New password (12+ characters)<input name="password" type="password" autocomplete="new-password" required minlength="12" class={field} disabled={disabled} /></label>
      <label class="block text-sm text-fg-muted">Confirm password<input name="confirm" type="password" autocomplete="new-password" required minlength="12" class={field} disabled={disabled} /></label>
      <button type="submit" class="btn-primary disabled:cursor-not-allowed disabled:opacity-50" disabled={disabled}>Set new password</button>
    </form>
    <p class="mt-6 text-sm"><a class="text-accent hover:underline" href="/account">Back to your account</a></p>
  </article>
  <script>
    import { mountResetPage } from '../../lib/account.js';
    mountResetPage(document.querySelector('[data-reset-root]'));
  </script>
</Base>
