---
import Base from '../layouts/Base.astro';
import SearchBox from '../components/SearchBox.astro';
import { getManifest } from '../lib/data';

let manifest;
try {
  manifest = await getManifest();
} catch {
  // Before the first run of `npm run data:build`, the shards don't exist.
  manifest = null;
}

const totalCountries = manifest?.total_countries ?? 250;
const totalHotlines = manifest?.total_hotlines ?? 0;

const featuredCategories = [
  { slug: 'suicide_crisis', label: 'Suicide & acute crisis', icon: '🆘' },
  { slug: 'child_protection', label: 'Child protection', icon: '🧒' },
  { slug: 'domestic_violence', label: 'Domestic violence', icon: '🛡️' },
  { slug: 'mental_health', label: 'Mental health', icon: '🧠' },
  { slug: 'sexual_violence', label: 'Sexual violence', icon: '💜' },
  { slug: 'lgbtqia', label: 'LGBTQIA+ support', icon: '🏳️‍🌈' },
  { slug: 'substance_use', label: 'Substance use', icon: '🍃' },
  { slug: 'veterans', label: 'Veterans', icon: '🎖️' },
];
---

<Base
  title="World Emergency & Hotlines"
  description="An exhaustive, open directory of emergency and crisis support numbers for every country in the world."
>
  <!-- Hero -->
  <section class="relative overflow-hidden pb-14 pt-10 sm:pt-16">
    <div class="relative z-10 mx-auto max-w-3xl text-center">
      <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-border bg-bg-elev/60 px-3 py-1 text-xs uppercase tracking-[0.2em] text-fg-muted">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-success"></span>
        {totalCountries} countries · {totalHotlines.toLocaleString()} hotlines
      </p>
      <h1 class="font-display text-5xl leading-[1.02] tracking-tight text-fg sm:text-6xl md:text-7xl">
        Help,<span class="italic text-accent"> wherever</span> you are.
      </h1>
      <p class="mx-auto mt-6 max-w-xl text-lg text-fg-muted">
        An open, exhaustive directory of emergency and crisis support numbers for every country in the world —
        police, suicide lines, childlines, mental-health support, and more.
      </p>

      <div class="mt-10">
        <SearchBox />
        <p class="mt-3 text-xs text-fg-muted">
          Tip: type a country and a category, e.g. <span class="text-fg">"Australia veterans"</span> or <span class="text-fg">"UK childline"</span>.
        </p>
      </div>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href="/map" class="btn-primary">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/></svg>
          Open the world map
        </a>
        <a href="/about" class="btn-ghost">How this works</a>
      </div>
    </div>

    <!-- decorative orb -->
    <div aria-hidden="true" class="pointer-events-none absolute left-1/2 top-[40%] -z-0 h-[600px] w-[600px] -translate-x-1/2 rounded-full bg-accent/10 blur-[120px]"></div>
  </section>

  <!-- Categories -->
  <section class="pt-6">
    <div class="mb-6 flex items-end justify-between">
      <h2 class="font-display text-2xl text-fg">Browse by category</h2>
      <a href="/categories" class="text-sm text-fg-muted hover:text-fg">All categories →</a>
    </div>
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4">
      {
        featuredCategories.map((c) => (
          <a
            href={`/category/${c.slug}`}
            class="card group flex flex-col justify-between gap-6 p-5 transition hover:-translate-y-0.5 hover:border-accent/60"
          >
            <span class="text-2xl" aria-hidden="true">{c.icon}</span>
            <span class="text-sm font-medium text-fg">{c.label}</span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Trust / methodology strip -->
  <section class="mt-16 rounded-3xl border border-border bg-bg-elev/40 p-6 sm:p-10">
    <div class="grid gap-8 md:grid-cols-3">
      <div>
        <h3 class="font-display text-lg text-fg">Verified where possible</h3>
        <p class="mt-2 text-sm text-fg-muted">
          Every hotline carries a verification status. We never hide a record — we label its confidence so you can decide.
        </p>
      </div>
      <div>
        <h3 class="font-display text-lg text-fg">Private by design</h3>
        <p class="mt-2 text-sm text-fg-muted">
          The natural-language finder runs entirely in your browser. Your words never leave your device.
        </p>
      </div>
      <div>
        <h3 class="font-display text-lg text-fg">Open data</h3>
        <p class="mt-2 text-sm text-fg-muted">
          The whole dataset is downloadable as JSON. Fork, mirror, improve — crises don't respect licence walls.
        </p>
      </div>
    </div>
  </section>
</Base>
