---
import Base from '../layouts/Base.astro';
import SearchBox from '../components/SearchBox.astro';
import Icon from '../components/Icon.astro';
import { getManifest } from '../lib/data';
import { CATEGORY_META } from '../lib/types';

let manifest;
try {
  manifest = await getManifest();
} catch {
  manifest = null;
}

const totalCountries = manifest?.total_countries ?? 250;
const totalHotlines = manifest?.total_hotlines ?? 0;
const featuredCategories = [
  'suicide_crisis',
  'child_protection',
  'domestic_violence',
  'mental_health',
  'sexual_violence',
  'lgbtqia',
  'substance_use',
  'veterans',
].map((slug) => ({ slug, ...CATEGORY_META[slug] }));
---

<Base title="World Emergency & Hotlines" description="A source-backed global directory of emergency and crisis support services with visible provenance and source-check dates.">
  <section class="relative z-20 pb-14 pt-10 sm:pt-16">
    {/* Decorative blur orb — clipped to its own wrapper so it does not force
        overflow-hidden on the whole section (which was clipping the search
        dropdown and making results unclickable). */}
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
      <div class="absolute left-1/2 top-[40%] h-[600px] w-[600px] -translate-x-1/2 rounded-full bg-accent/10 blur-[120px]"></div>
    </div>
    <div class="relative z-10 mx-auto max-w-3xl text-center">
      <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-border bg-bg-elev/70 px-3 py-1 text-xs uppercase tracking-[0.2em] text-fg-muted" data-i18n-template="home.stats" data-i18n-args={JSON.stringify({ countries: totalCountries, hotlines: totalHotlines })}>
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-success"></span>
        {totalCountries} countries · {totalHotlines.toLocaleString()} hotlines
      </p>
      <h1 class="text-5xl font-semibold leading-[1.02] tracking-tight text-fg sm:text-6xl md:text-7xl" data-i18n="home.heroTitle">
        Clearer help, wherever you are.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-fg-muted" data-i18n="home.heroBody">
        A public, easy-to-read directory of emergency and crisis support numbers for every country in the world — police, suicide lines, childlines, mental-health support, and more.
      </p>

      <div class="mt-10">
        <SearchBox />
        <p class="mt-3 text-xs text-fg-muted" data-i18n="home.tip">
          Tip: type a country and a category, for example “Australia veterans” or “UK childline”.
        </p>
      </div>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href="/find-help" class="btn-primary">
          <Icon name="search" class="h-4 w-4" />
          Find help step by step
        </a>
        <a href="/map" class="btn-primary">
          <Icon name="map" class="h-4 w-4" />
          <span data-i18n="home.mapCta">Open the world map</span>
        </a>
        <a href="/about" class="btn-ghost">
          <Icon name="heart" class="h-4 w-4" />
          <span data-i18n="home.howItWorks">How this works</span>
        </a>
      </div>
    </div>

    <div aria-hidden="true" class="pointer-events-none absolute left-1/2 top-[40%] -z-0 h-[600px] w-[600px] -translate-x-1/2 rounded-full bg-accent/10 blur-[120px]"></div>
  </section>

  <section class="pt-6">
    <div class="mb-6 flex items-end justify-between gap-4">
      <h2 class="text-2xl font-semibold text-fg" data-i18n="home.browse">Browse by category</h2>
      <a href="/categories" class="inline-flex items-center gap-1 text-sm text-fg-muted hover:text-fg">
        <span data-i18n="home.allCategories">All categories</span>
        <Icon name="chevron-right" class="h-3.5 w-3.5" />
      </a>
    </div>
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4">
      {featuredCategories.map((c) => (
        <a href={`/category/${c.slug}`} class="card group flex flex-col justify-between gap-6 p-5 transition hover:-translate-y-0.5 hover:border-accent/60">
          <span class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-accent/12 text-accent"><Icon name={c.icon} class="h-5 w-5" /></span>
          <span class="text-sm font-medium text-fg" data-i18n={`category.${c.slug}`}>{c.label}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="mt-16 rounded-3xl border border-border bg-bg-elev/40 p-6 sm:p-10">
    <div class="grid gap-8 md:grid-cols-3">
      <div>
        <h3 class="text-lg font-semibold text-fg" data-i18n="home.verifiedTitle">Verified where possible</h3>
        <p class="mt-2 text-sm text-fg-muted" data-i18n="home.verifiedBody">Every hotline carries a verification status. We never hide a record — we label its confidence so you can decide.</p>
      </div>
      <div>
        <h3 class="text-lg font-semibold text-fg" data-i18n="home.privateTitle">Private by design</h3>
        <p class="mt-2 text-sm text-fg-muted" data-i18n="home.privateBody">The natural-language finder runs entirely in your browser. Your words never leave your device.</p>
      </div>
      <div>
        <h3 class="text-lg font-semibold text-fg" data-i18n="home.openDataTitle">Public data access</h3>
        <p class="mt-2 text-sm text-fg-muted" data-i18n="home.openDataBody">The dataset is publicly downloadable as JSON. The repository currently has no license; access does not itself grant reuse rights.</p>
      </div>
    </div>
  </section>
</Base>
