---
import Base from '../layouts/Base.astro';
---

<Base title="Not found · Hotlines">
  <div class="mx-auto max-w-xl py-20 text-center">
    <p class="text-xs uppercase tracking-[0.3em] text-fg-muted">404</p>
    <h1 class="mt-3 font-display text-5xl text-fg">Page not found</h1>
    <p class="mt-4 text-fg-muted">
      The page you were looking for doesn't exist, or has moved. If you were trying to reach a country's hotlines,
      try the world map or search from the home page.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-primary">Home</a>
      <a href="/map" class="btn-ghost">Open map</a>
    </div>
  </div>
</Base>
